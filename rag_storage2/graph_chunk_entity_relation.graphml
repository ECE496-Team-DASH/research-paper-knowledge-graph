    <node id="KG-based GraphRAG (KG-GraphRAG)">
      <data key="d0">KG-based GraphRAG (KG-GraphRAG)</data>
      <data key="d1">method</data>
      <data key="d2">A representative GraphRAG method that constructs a knowledge graph from text using LLMs and performs retrieval based on traversing triplets and their associated text.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
