    </node>
    <node id="lexical search">
      <data key="d0">lexical search</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval method used in RAG to find relevant text chunks based on keyword matching.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="OpenAI’s text-embedding-ada-002 model">
      <data key="d0">OpenAI’s text-embedding-ada-002 model</data>
      <data key="d1">technology</data>
      <data key="d2">An embedding model used for indexing text chunks in the RAG system.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Llama-3.1-8B-Instruct">
      <data key="d0">Llama-3.1-8B-Instruct</data>
      <data key="d1">technology</data>
      <data key="d2">An open-source Large Language Model used as a generator for responses in the evaluated RAG and GraphRAG systems.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Llama-3.1-70B-Instruct">
      <data key="d0">Llama-3.1-70B-Instruct</data>
      <data key="d1">technology</data>
      <data key="d2">A larger open-source Large Language Model used as a generator for responses in the evaluated RAG and GraphRAG systems.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Natural Questions (NQ)">
      <data key="d0">Natural Questions (NQ)</data>
      <data key="d1">dataset</data>
      <data key="d2">A widely used benchmark dataset for single-hop open-domain question answering.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="NovelQA">
      <data key="d0">NovelQA</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset designed to evaluate long-text understanding and retrieval ability of LLMs using questions about English novels.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="SQuALITY">
      <data key="d0">SQuALITY</data>
      <data key="d1">dataset</data>
      <data key="d2">A question-focused, long-document, multi-reference summarization dataset.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="QMSum">
      <data key="d0">QMSum</data>
      <data key="d1">dataset</data>
      <data key="d2">A human-annotated benchmark dataset for query-based, multi-domain meeting summarization.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="ODSum-story">
      <data key="d0">ODSum-story</data>
      <data key="d1">dataset</data>
      <data key="d2">A subset of the ODSum dataset for multi-document query-based summarization, derived from SQuALITY.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="ODSum-meeting">
      <data key="d0">ODSum-meeting</data>
      <data key="d1">dataset</data>
      <data key="d2">A subset of the ODSum dataset for multi-document query-based summarization, constructed from QMSum.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Hybrid Retrieval Strategies">
      <data key="d0">Hybrid Retrieval Strategies</data>
      <data key="d1">method</data>
      <data key="d2">Strategies proposed to integrate the strengths of RAG and GraphRAG to enhance overall performance in QA tasks.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Selection (Strategy)">
      <data key="d0">Selection (Strategy)</data>
      <data key="d1">method</data>
      <data key="d2">A hybrid retrieval strategy where queries are dynamically assigned to either RAG or GraphRAG based on their characteristics (e.g., fact-based vs. reasoning-based) for efficiency.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Integration (Strategy)">
      <data key="d0">Integration (Strategy)</data>
      <data key="d1">method</data>
      <data key="d2">A hybrid retrieval strategy where both RAG and GraphRAG simultaneously retrieve information, which is then concatenated and fed to the generator for final output, aiming for higher performance.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="in-context learning">
      <data key="d0">in-context learning</data>
      <data key="d1">concept</data>
      <data key="d2">The ability of LLMs to learn from examples provided within the prompt, leveraged for query classification.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="LLM-as-a-Judge">
      <data key="d0">LLM-as-a-Judge</data>
      <data key="d1">method</data>
      <data key="d2">An evaluation method where an LLM is used to assess the quality of generated responses, particularly for summarization, often by comparing different model outputs.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="position bias">
      <data key="d0">position bias</data>
      <data key="d1">concept</data>
      <data key="d2">A phenomenon where the order in which summaries are presented to an LLM-as-a-Judge significantly affects its predictions, impacting evaluation reliability.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="ROUGE-2">
      <data key="d0">ROUGE-2</data>
      <data key="d1">method</data>
      <data key="d2">An evaluation metric used to measure lexical similarity between predicted and ground truth summaries.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="BERTScore">
      <data key="d0">BERTScore</data>
      <data key="d1">method</data>
      <data key="d2">An evaluation metric used to measure semantic similarity between predicted and ground truth summaries.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="Abstract Meaning Representation (AMR)">
      <data key="d0">Abstract Meaning Representation (AMR)</data>
      <data key="d1">concept</data>
      <data key="d2">A graph-based semantic representation used in some studies to construct document graphs for improving document ranking.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
