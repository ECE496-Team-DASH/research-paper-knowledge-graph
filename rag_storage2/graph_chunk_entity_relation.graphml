    <node id="Graph Retrieval-Augmented Generation (GraphRAG)">
      <data key="d0">Graph Retrieval-Augmented Generation (GraphRAG)</data>
      <data key="d1">method</data>
      <data key="d2">A framework that enhances Large Language Model (LLM) reasoning by integrating structured knowledge from external graphs. The paper proposes improvements to this framework.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="Text-Attributed Graphs (TAGs)">
      <data key="d0">Text-Attributed Graphs (TAGs)</data>
      <data key="d1">Concept</data>
      <data key="d2">A universal format for graph data used in GraphRAG, where nodes and edges possess textual attributes, unifying representation for various graph types including Knowledge Graphs.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Graph-Based Indexing (G-Indexing)">
      <data key="d0">Graph-Based Indexing (G-Indexing)</data>
      <data key="d1">Method</data>
      <data key="d2">The initial phase of GraphRAG focused on constructing or identifying a graph database and establishing indices (graph, text, vector) to enhance the efficiency and speed of query operations.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Graph-Guided Retrieval (G-Retrieval)">
      <data key="d0">Graph-Guided Retrieval (G-Retrieval)</data>
      <data key="d1">Method</data>
      <data key="d2">The phase in GraphRAG that extracts pertinent information (nodes, triplets, paths, subgraphs) from the graph database in response to user queries, utilizing various retriever types and paradigms.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Graph-Enhanced Generation (G-Generation)">
      <data key="d0">Graph-Enhanced Generation (G-Generation)</data>
      <data key="d1">Method</data>
      <data key="d2">The final phase in GraphRAG where retrieved graph data is integrated with the query to synthesize meaningful outputs or responses, using generators like LLMs or GNNs and various graph formats.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Question Answering (QA)">
      <data key="d0">Question Answering (QA)</data>
      <data key="d1">Task</data>
      <data key="d2">A broad downstream task in NLP where GraphRAG is applied, encompassing sub-tasks like Knowledge Base Question Answering (KBQA) and Commonsense Question Answering (CSQA).</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Knowledge Base Question Answering (KBQA)">
      <data key="d0">Knowledge Base Question Answering (KBQA)</data>
      <data key="d1">Task</data>
      <data key="d2">A specific type of Question Answering where questions relate to and answers are derived from structured knowledge graphs, serving as a cornerstone application for GraphRAG systems.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Commonsense Question Answering (CSQA)">
      <data key="d0">Commonsense Question Answering (CSQA)</data>
      <data key="d1">Task</data>
      <data key="d2">A specific type of Question Answering that involves using external commonsense knowledge graphs to reason and derive answers to multiple-choice questions requiring abstract commonsense knowledge.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="BOCI PENG">
      <data key="d0">BOCI PENG</data>
      <data key="d1">Person</data>
      <data key="d2">An author of the survey 'Graph Retrieval-Augmented Generation: A Survey' affiliated with Peking University.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="YUN ZHU">
      <data key="d0">YUN ZHU</data>
      <data key="d1">Person</data>
      <data key="d2">An author of the survey 'Graph Retrieval-Augmented Generation: A Survey' affiliated with Zhejiang University.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Ant Group">
      <data key="d0">Ant Group</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that supported research in GraphRAG through its Ant Research Intern Program.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Peking University">
      <data key="d0">Peking University</data>
      <data key="d1">Organization</data>
      <data key="d2">A university affiliated with authors (Boci Peng, Yan Zhang) of the 'Graph Retrieval-Augmented Generation: A Survey' paper.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Wikidata">
      <data key="d0">Wikidata</data>
      <data key="d1">technology</data>
      <data key="d2">A collaboratively edited multilingual knowledge base, serving as a central storage for structured data and supported by LC-QuAD v2.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="ConceptNet">
      <data key="d0">ConceptNet</data>
      <data key="d1">technology</data>
      <data key="d2">A freely available semantic network designed to help computers understand the meanings of words people use.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="WebQSP">
      <data key="d0">WebQSP</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset for knowledge graph question answering, containing natural language questions that require reasoning over paths of up to two hops, used for evaluating model performance.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="MetaQA">
      <data key="d0">MetaQA</data>
      <data key="d1">dataset</data>
      <data key="d2">A movie domain dataset with over 400,000 questions structured around a knowledge graph, organized by reasoning hop difficulty.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="BERT">
      <data key="d0">BERT</data>
      <data key="d1">technology</data>
      <data key="d2">A well-known text-encoder model used for generating embeddings for nodes or relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="RoBERTa">
      <data key="d0">RoBERTa</data>
      <data key="d1">Technology</data>
      <data key="d2">A robustly optimized BERT pretraining approach, used as a retriever model in some GraphRAG systems like Subgraph Retriever.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Transformer">
      <data key="d0">Transformer</data>
      <data key="d1">Technology</data>
      <data key="d2">The architectural foundation upon which many modern Large Language Models (LLMs) are built, enabling their advanced language processing capabilities.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Query Expansion">
      <data key="d0">Query Expansion</data>
      <data key="d1">Method</data>
      <data key="d2">A technique within query enhancement that supplements or refines the original user query with additional relevant terms or concepts to improve retrieval results.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Knowledge Pruning">
      <data key="d0">Knowledge Pruning</data>
      <data key="d1">Method</data>
      <data key="d2">A technique within knowledge enhancement that involves filtering out less relevant or redundant retrieved information to refine the retrieval results and reduce noise.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Nodes (retrieval granularity)">
      <data key="d0">Nodes (retrieval granularity)</data>
      <data key="d1">Concept</data>
      <data key="d2">A retrieval granularity in GraphRAG focused on extracting individual elements (entities or textual information) from the graph, suitable for targeted queries.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Subgraphs (retrieval granularity)">
      <data key="d0">Subgraphs (retrieval granularity)</data>
      <data key="d1">Concept</data>
      <data key="d2">A retrieval granularity in GraphRAG that extracts interconnected sets of nodes and edges, offering comprehensive relational contexts and deeper insights.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Training-Free (training strategy)">
      <data key="d0">Training-Free (training strategy)</data>
      <data key="d1">Method</data>
      <data key="d2">A training strategy in GraphRAG where models (often closed-source LLMs or non-parametric retrievers) are used without explicit fine-tuning, relying instead on prompt engineering.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Joint Training">
      <data key="d0">Joint Training</data>
      <data key="d1">Method</data>
      <data key="d2">A training strategy in GraphRAG where retrievers and generators are trained simultaneously or in an alternating fashion to enhance their synergy and overall performance on downstream tasks.</data>
      <data key="d3">chunk-bfbd0ad801c974a4da9c5fd6665ac869</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720248</data>
    </node>
    <node id="Self-Constructed Graph Data">
      <data key="d0">Self-Constructed Graph Data</data>
      <data key="d3">chunk-d09b8f6ca213f86db826ad59f74859ec</data>
      <data key="d2">UNKNOWN</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720212</data>
    </node>
    <node id="CSQA">
      <data key="d0">CSQA</data>
      <data key="d3">chunk-d09b8f6ca213f86db826ad59f74859ec</data>
      <data key="d2">UNKNOWN</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720212</data>
    </node>
    <node id="Knowledge Graph (KG)">
      <data key="d0">Knowledge Graph (KG)</data>
      <data key="d1">method</data>
      <data key="d2">A type of graph constructed by extracting entities and relationships from each chunk.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="E-commerce">
      <data key="d0">E-commerce</data>
      <data key="d1">application</data>
      <data key="d2">An application domain where GraphRAG is widely used for personalized recommendations, intelligent customer services, and forecasting purchasing intentions by analyzing user-product relationships as graphs.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Biomedical Domain">
      <data key="d0">Biomedical Domain</data>
      <data key="d1">application</data>
      <data key="d2">An application area where GraphRAG techniques are increasingly applied in question answering systems to achieve advanced medical decision-making by linking diseases, symptoms, and medications.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Academic Research Domain">
      <data key="d0">Academic Research Domain</data>
      <data key="d1">application</data>
      <data key="d2">An application domain where GraphRAG is used to facilitate academic exploration, such as predicting potential collaborators and identifying trends, by structuring research elements into a graph.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Legal Contexts">
      <data key="d0">Legal Contexts</data>
      <data key="d1">application</data>
      <data key="d2">An application domain where GraphRAG aids lawyers and legal researchers in tasks like case analysis and legal consultation by structuring citation connections between cases and judicial opinions into a graph.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="CMeKG">
      <data key="d0">CMeKG</data>
      <data key="d1">dataset</data>
      <data key="d2">An open-source knowledge graph utilized as a retrieval source in biomedical question answering systems.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="CPubMed-KG">
      <data key="d0">CPubMed-KG</data>
      <data key="d1">dataset</data>
      <data key="d2">An open-source knowledge graph, likely derived from PubMed, used as a retrieval source in biomedical applications.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Non-parametric Retrievers">
      <data key="d0">Non-parametric Retrievers</data>
      <data key="d1">method</data>
      <data key="d2">A method used for initial search in GraphRAG systems to retrieve relevant content before further filtering.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Re-ranking">
      <data key="d0">Re-ranking</data>
      <data key="d1">method</data>
      <data key="d2">A method used in GraphRAG systems to filter and prioritize retrieved content, enhancing the relevance of information.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Wang et al.">
      <data key="d0">Wang et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who utilized an ensemble of multiple retrievers to extract relevant subgraphs for temporal user action prediction in E-commerce.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Xu et al.">
      <data key="d0">Xu et al.</data>
      <data key="d1">person</data>
      <data key="d2">Researchers who constructed a past-issue graph with intra-issue and inter-issue relations to improve customer service question answering systems.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Event Plot Graph (EPG)">
      <data key="d0">Event Plot Graph (EPG)</data>
      <data key="d1">data structure</data>
      <data key="d2">A specific graph structure constructed by Ranade and Joshi [139] for retrieving critical aspects of events to aid intelligence report generation.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Patent-phrase graph">
      <data key="d0">Patent-phrase graph</data>
      <data key="d1">data structure</data>
      <data key="d2">A graph structure created by Peng and Yang [133] to model patent phrases and their ego networks for similarity detection.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Dependency Graph">
      <data key="d0">Dependency Graph</data>
      <data key="d1">data structure</data>
      <data key="d2">A graph structure automatically constructed by Alhanahnah et al. [1] for a chatbot to understand properties and dependencies within software packages.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="STARK">
      <data key="d0">STARK</data>
      <data key="d1">benchmark</data>
      <data key="d2">A benchmark dataset designed to evaluate LLM Retrieval performance on semi-structured knowledge bases across domains like product search, academic paper search, and precision medicine.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="GraphQA">
      <data key="d0">GraphQA</data>
      <data key="d1">dataset</data>
      <data key="d2">A flexible question-answering benchmark proposed by He et al. [55] targeting real-world textual graphs and applicable to various reasoning tasks.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Graph Reasoning Benchmark (GRBENCH)">
      <data key="d0">Graph Reasoning Benchmark (GRBENCH)</data>
      <data key="d1">benchmark</data>
      <data key="d2">A dataset constructed to facilitate research on augmenting LLMs with graphs, containing questions answerable with knowledge from 10 domain graphs.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="CRAG">
      <data key="d0">CRAG</data>
      <data key="d1">benchmark</data>
      <data key="d2">A comprehensive RAG benchmark that provides a structured query dataset and mock APIs for consistent evaluation of GraphRAG systems.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Exact Match (EM)">
      <data key="d0">Exact Match (EM)</data>
      <data key="d1">metric</data>
      <data key="d2">A commonly used metric to measure the accuracy of answering entities in Knowledge Base Question Answering (KBQA), requiring a perfect match to the ground truth.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="F1 score">
      <data key="d0">F1 score</data>
      <data key="d1">metric</data>
      <data key="d2">A metric that measures the accuracy of answers in tasks like KBQA, considering both precision and recall.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="BERT4Score">
      <data key="d0">BERT4Score</data>
      <data key="d1">metric</data>
      <data key="d2">A metric used to evaluate the semantic quality of generated text, addressing instances where LLMs produce synonymous but not exact matches to the ground truth.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="GPT4Score">
      <data key="d0">GPT4Score</data>
      <data key="d1">metric</data>
      <data key="d2">A metric used to evaluate the semantic quality of generated text, similar to BERT4Score, leveraging the capabilities of GPT-4.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Accuracy">
      <data key="d0">Accuracy</data>
      <data key="d1">metric</data>
      <data key="d2">The most commonly used evaluation metric for Commonsense Question Answering (CSQA).</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="BLEU">
      <data key="d0">BLEU</data>
      <data key="d1">metric</data>
      <data key="d2">A commonly employed metric to assess the quality of text generated by models in generative tasks such as QA systems.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="METEOR">
      <data key="d0">METEOR</data>
      <data key="d1">metric</data>
      <data key="d2">A metric commonly employed to assess the quality of text generated by models, considering precision, recall, and stemming, among other factors.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
