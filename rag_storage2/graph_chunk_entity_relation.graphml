      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="QUEST">
      <data key="d0">QUEST</data>
      <data key="d1">technology</data>
      <data key="d2">A Knowledge-based GraphRAG method that constructs attributed KGs, emphasizing integrating entities, relations, types, and semantic alignments.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GraphReader">
      <data key="d0">GraphReader</data>
      <data key="d1">technology</data>
      <data key="d2">A Knowledge-based GraphRAG method that employs an LLM to summarize text chunks into atomic facts and extract key elements for node creation.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
