    <node id="GPT series">
      <data key="d0">GPT series</data>
      <data key="d1">technology</data>
      <data key="d2">A family of Large Language Models known for capabilities in text comprehension, question answering, and content generation.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Awesome-GraphRAG">
      <data key="d0">Awesome-GraphRAG</data>
      <data key="d1">dataset</data>
      <data key="d2">A collection of related resources, including research papers, open-source data, and projects on GraphRAG, maintained by DEEP-PolyU.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="DEEP-PolyU">
      <data key="d0">DEEP-PolyU</data>
      <data key="d1">organization</data>
      <data key="d2">A research group or lab associated with The Hong Kong Polytechnic University, maintaining a collection of GraphRAG resources.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="supervised fine-tuning">
      <data key="d0">supervised fine-tuning</data>
      <data key="d1">method</data>
      <data key="d2">A strategy for adapting LLMs to specific domains by training them on specialized datasets, with risks of catastrophic forgetting.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="catastrophic forgetting">
      <data key="d0">catastrophic forgetting</data>
      <data key="d1">concept</data>
      <data key="d2">A phenomenon in neural networks where learning new information causes the model to forget previously learned information.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="hierarchical RAG">
      <data key="d0">hierarchical RAG</data>
      <data key="d1">method</data>
      <data key="d2">An advanced RAG system that preserves document structure through multi-level retrieval.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="re-ranking systems">
      <data key="d0">re-ranking systems</data>
      <data key="d1">method</data>
      <data key="d2">Advanced RAG systems that implement a two-stage retrieval process for higher recall and precision.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="self-querying RAG">
      <data key="d0">self-querying RAG</data>
      <data key="d1">method</data>
      <data key="d2">An advanced RAG system that automatically decomposes complex queries.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="adaptive RAG">
      <data key="d0">adaptive RAG</data>
      <data key="d1">method</data>
      <data key="d2">An advanced RAG system that dynamically adjusts retrieval strategies based on query types.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="k-nearest neighbor retrieval (KNN)">
      <data key="d0">k-nearest neighbor retrieval (KNN)</data>
      <data key="d1">method</data>
      <data key="d2">A common retrieval method used in traditional RAG to extract relevant neighbors by calculating L2 distance in a vector space.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="term frequency-inverse document frequency (TF-IDF)">
      <data key="d0">term frequency-inverse document frequency (TF-IDF)</data>
      <data key="d1">method</data>
      <data key="d2">A statistical measure used as a retrieval method or for constructing lexical-similarity-based index graphs.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="best matching 25 (BM25)">
      <data key="d0">best matching 25 (BM25)</data>
      <data key="d1">method</data>
      <data key="d2">A ranking function used by search engines to estimate the relevance of documents to a given search query.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="RETRO">
      <data key="d0">RETRO</data>
      <data key="d1">technology</data>
      <data key="d2">A model that employs KNN to extract approximate relevant neighbors from a key-value database.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="RETRO-prompt">
      <data key="d0">RETRO-prompt</data>
      <data key="d1">technology</data>
      <data key="d2">An extension of RETRO that constructs a few-shot knowledge store tailored for prompt learning scenarios.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GAR">
      <data key="d0">GAR</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that introduces diverse context generation to enrich initial queries before applying BM25 retrieval.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="EAR">
      <data key="d0">EAR</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that implements a re-ranking process to select the optimal candidate from multiple expanded queries for improved retrieval accuracy.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="sentence transformers">
      <data key="d0">sentence transformers</data>
      <data key="d1">technology</data>
      <data key="d2">Models used to generate dense vector representations of sentences, aiding in approximate neighbor identification.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="REPLUG">
      <data key="d0">REPLUG</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that leverages labels generated by a frozen language model to supervise the training of retrieval models.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="ATLAS">
      <data key="d0">ATLAS</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that fine-tunes both the retriever and LLMs in tandem to enhance retrieval quality.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="FLARE">
      <data key="d0">FLARE</data>
      <data key="d1">technology</data>
      <data key="d2">An active RAG framework that dynamically balances retrieval with generation needs by intelligently determining retrieval timings.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Toolformer">
      <data key="d0">Toolformer</data>
      <data key="d1">technology</data>
      <data key="d2">A model that taps into external tools and knowledge bases like Wikipedia to access extensive knowledge.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Wikipedia">
      <data key="d0">Wikipedia</data>
      <data key="d1">technology</data>
      <data key="d2">A widely used general-purpose encyclopedia, often serving as a source for knowledge graphs and background knowledge in AI models.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Google Search APIs">
      <data key="d0">Google Search APIs</data>
      <data key="d1">technology</data>
      <data key="d2">External APIs used by RAG systems to ensure the most current and comprehensive information is incorporated.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="LeanContext">
      <data key="d0">LeanContext</data>
      <data key="d1">technology</data>
      <data key="d2">A system that utilizes reinforcement learning to selectively choose sentences most pertinent to the query, minimizing context size.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="SELF-RAG">
      <data key="d0">SELF-RAG</data>
      <data key="d1">technology</data>
      <data key="d2">A system that introduces a self-reflection mechanism, allowing the language model to assess its own generated and retrieved content for corrective measures.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="SKR">
      <data key="d0">SKR</data>
      <data key="d1">technology</data>
      <data key="d2">A dynamic framework where LLMs rely on pre-trained knowledge for recognized queries and resort to retrieval only when necessary.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="FILCO">
      <data key="d0">FILCO</data>
      <data key="d1">technology</data>
      <data key="d2">A system that enhances RAG by training a context filtering model to screen out irrelevant data and mitigate hallucination risks.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Selfmem">
      <data key="d0">Selfmem</data>
      <data key="d1">technology</data>
      <data key="d2">An approach that constructs a memory pool from LLM-generated results, using an iterative selection framework to enhance generative quality.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="SAIL">
      <data key="d0">SAIL</data>
      <data key="d1">technology</data>
      <data key="d2">A system that forms an instruction-tuning dataset based on retrieval outcomes, fine-tuning LLMs to ground responses in reliable content.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="LUMEN">
      <data key="d0">LUMEN</data>
      <data key="d1">technology</data>
      <data key="d2">A system that conditions the encoder on current inputs and fine-tunes it for high-quality pre-encoded memory representations.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="PipeRAG">
      <data key="d0">PipeRAG</data>
      <data key="d1">technology</data>
      <data key="d2">An innovative parallelism solution that advances RAG efficiency by enabling concurrent retrieval and generation.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="RAGCache">
      <data key="d0">RAGCache</data>
      <data key="d1">technology</data>
      <data key="d2">A system that optimizes resource usage by caching intermediate states within a GPU-resident knowledge tree.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="TCRA-LLM">
      <data key="d0">TCRA-LLM</data>
      <data key="d1">technology</data>
      <data key="d2">A system that utilizes a token compression strategy, optimizing the semantic relevance of tokens to conserve computational resources.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="hallucination">
      <data key="d0">hallucination</data>
      <data key="d1">concept</data>
      <data key="d2">The phenomenon where LLMs generate factually incorrect or nonsensical information.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="vector database">
      <data key="d0">vector database</data>
      <data key="d1">technology</data>
      <data key="d2">A database system used in traditional RAG to store text chunks as vector embeddings for efficient similarity-based retrieval.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="recursive splits">
      <data key="d0">recursive splits</data>
      <data key="d1">method</data>
      <data key="d2">A chunking strategy used to split documents into manageable pieces while optimizing context length.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="sliding windows">
      <data key="d0">sliding windows</data>
      <data key="d1">method</data>
      <data key="d2">A chunking strategy used to split documents into manageable pieces while optimizing context length.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Small-to-Big">
      <data key="d0">Small-to-Big</data>
      <data key="d1">method</data>
      <data key="d2">A chunking strategy used to split documents into manageable pieces while optimizing context length.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Knowledge-based GraphRAG">
      <data key="d0">Knowledge-based GraphRAG</data>
      <data key="d1">concept</data>
      <data key="d2">A category of GraphRAG that uses graphs as knowledge carriers, transforming unstructured text into structured KGs.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Index-based GraphRAG">
      <data key="d0">Index-based GraphRAG</data>
      <data key="d1">concept</data>
      <data key="d2">A category of GraphRAG that uses graphs as index tools to retrieve relevant raw texts from the corpus.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Hybrid GraphRAG">
      <data key="d0">Hybrid GraphRAG</data>
      <data key="d1">concept</data>
      <data key="d2">A category of GraphRAG that combines the strengths of both knowledge-based and index-based frameworks.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="graph neural networks (GNNs)">
      <data key="d0">graph neural networks (GNNs)</data>
      <data key="d1">technology</data>
      <data key="d2">A type of neural network designed to process data represented as graphs, used in GraphRAG for encoding nodes and extracting features.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GNN-ret">
      <data key="d0">GNN-ret</data>
      <data key="d1">technology</data>
      <data key="d2">An Index-based GraphRAG method that creates a passage-level graph connecting passages through structural and keyword similarities.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="PG-RAG">
      <data key="d0">PG-RAG</data>
      <data key="d1">technology</data>
      <data key="d2">An Index-based GraphRAG method that forms a pseudo-graph by linking concise reading material summaries.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="KGP">
      <data key="d0">KGP</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
