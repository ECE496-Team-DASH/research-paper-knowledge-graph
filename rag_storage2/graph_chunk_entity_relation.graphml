    <node id="Breadth-First Search (BFS)">
      <data key="d0">Breadth-First Search (BFS)</data>
      <data key="d1">method</data>
      <data key="d2">A graph traversal algorithm used in Antgroup's GraphRAG system during the retrieval phase to locate and traverse subgraphs.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
