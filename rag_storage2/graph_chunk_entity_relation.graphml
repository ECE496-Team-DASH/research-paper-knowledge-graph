      <data key="d2">Structured systems establishing standards, policies, and procedures for data handling, access control, and ethical use.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Access control">
