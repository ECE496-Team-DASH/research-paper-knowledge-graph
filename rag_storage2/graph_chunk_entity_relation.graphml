    </node>
    <node id="AVIS">
      <data key="d0">AVIS</data>
      <data key="d1">technology</data>
      <data key="d2">An Index-based GraphRAG method that generates a transition graph based on user decisions for robot task planning.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="SayPlan">
