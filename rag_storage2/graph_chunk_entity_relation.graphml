    <node id="University of Hong Kong">
      <data key="d0">University of Hong Kong</data>
      <data key="d1">organization</data>
      <data key="d2">An academic institution and affiliation of some authors of the LightRAG research paper, also hosting the open-source LightRAG repository.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Graph Structures">
      <data key="d0">Graph Structures</data>
      <data key="d1">concept</data>
      <data key="d2">A data representation method incorporated into LightRAG's text indexing and retrieval processes to represent interdependencies among entities and enhance contextual awareness.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Dual-level Retrieval Paradigm">
      <data key="d0">Dual-level Retrieval Paradigm</data>
      <data key="d1">method</data>
      <data key="d2">A key retrieval strategy in LightRAG that accommodates diverse query types by performing both low-level retrieval (specific entities) and high-level retrieval (broader topics).</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Incremental Update Algorithm">
      <data key="d0">Incremental Update Algorithm</data>
      <data key="d1">method</data>
      <data key="d2">A method in LightRAG that allows for timely and efficient integration of new data into the knowledge base without full reprocessing, ensuring the system remains current.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Chunking">
      <data key="d0">Chunking</data>
      <data key="d1">method</data>
      <data key="d2">A technique used in RAG systems to break down large text corpora into smaller, more manageable segments to improve information retrieval accuracy.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Knowledge Graph">
      <data key="d0">Knowledge Graph</data>
      <data key="d1">data structure</data>
      <data key="d2">A comprehensive graph representation built by LightRAG to capture entities and their relationships from text, facilitating enhanced information retrieval and contextual understanding.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Retrieval Component">
      <data key="d0">Retrieval Component</data>
      <data key="d1">method</data>
      <data key="d2">A functional part of a RAG system responsible for fetching relevant documents or information from an external knowledge database based on an input query.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Generation Component">
      <data key="d0">Generation Component</data>
      <data key="d1">method</data>
      <data key="d2">A functional part of a RAG system that uses the retrieved information and a language model to produce coherent and contextually relevant responses.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Data Indexer φ(·)">
      <data key="d0">Data Indexer φ(·)</data>
      <data key="d1">method</data>
      <data key="d2">A function within the RAG framework that builds a specific data structure (ˆD) from the external database (D) for efficient information retrieval.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Data Retriever ψ(·)">
      <data key="d0">Data Retriever ψ(·)</data>
      <data key="d1">method</data>
      <data key="d2">A function within the RAG framework that obtains relevant documents by comparing the input query against the indexed data.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="GPT-4o-mini">
      <data key="d0">GPT-4o-mini</data>
      <data key="d1">technology</data>
      <data key="d2">A specific Large Language Model (LLM) utilized in LightRAG for various operations, including entity/relationship extraction, profiling, query generation, and evaluation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Graph-Enhanced Entity and Relationship Extraction">
      <data key="d0">Graph-Enhanced Entity and Relationship Extraction</data>
      <data key="d1">method</data>
      <data key="d2">A method used in LightRAG's graph-based text indexing that leverages LLMs to identify and extract entities and their relationships from segmented text documents.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="LLM Profiling for Key-Value Pair Generation P(·)">
      <data key="d0">LLM Profiling for Key-Value Pair Generation P(·)</data>
      <data key="d1">method</data>
      <data key="d2">A function in LightRAG that employs an LLM to generate descriptive text key-value pairs for entity nodes and relation edges, optimizing for rapid and precise retrieval.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Deduplication to Optimize Graph Operations D(·)">
      <data key="d0">Deduplication to Optimize Graph Operations D(·)</data>
      <data key="d1">method</data>
      <data key="d2">A function in LightRAG that identifies and merges identical entities and relations to reduce the size and overhead of the knowledge graph, leading to more efficient processing.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Vector Database">
      <data key="d0">Vector Database</data>
      <data key="d1">technology</data>
      <data key="d2">A specialized database used in LightRAG for efficient storage and similarity-based retrieval of vectorized representations of query keywords, entities, and relations.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="UltraDomain benchmark">
      <data key="d0">UltraDomain benchmark</data>
      <data key="d1">dataset</data>
      <data key="d2">A comprehensive benchmark dataset sourced from college textbooks across various domains, used to evaluate the effectiveness of LightRAG and baseline models.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Agriculture dataset">
      <data key="d0">Agriculture dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A domain-specific dataset from the UltraDomain benchmark focusing on agricultural practices, used for experimental evaluation of RAG systems.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="CS dataset">
      <data key="d0">CS dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A domain-specific dataset from the UltraDomain benchmark covering computer science topics like data science, machine learning, and big data processing, used for evaluation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Legal dataset">
      <data key="d0">Legal dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">The largest domain-specific dataset from the UltraDomain benchmark, focusing on corporate legal practices, used for experimental evaluation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Mix dataset">
      <data key="d0">Mix dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A domain-specific dataset from the UltraDomain benchmark comprising literary, biographical, and philosophical texts, used for experimental evaluation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Naive RAG">
      <data key="d0">Naive RAG</data>
      <data key="d1">method</data>
      <data key="d2">A standard baseline RAG method that segments raw texts into chunks, stores them as vector embeddings, and retrieves based on similarity matching.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="RQ-RAG">
      <data key="d0">RQ-RAG</data>
      <data key="d1">method</data>
      <data key="d2">A baseline RAG approach that uses an LLM to decompose input queries into multiple sub-queries to enhance search accuracy through explicit techniques like rewriting and disambiguation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="HyDE">
      <data key="d0">HyDE</data>
      <data key="d1">method</data>
      <data key="d2">A baseline RAG method that leverages an LLM to generate a hypothetical document from the input query, which then guides the retrieval of relevant text chunks.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="LLM-based multi-dimensional comparison method">
      <data key="d0">LLM-based multi-dimensional comparison method</data>
      <data key="d1">method</data>
      <data key="d2">The evaluation methodology used in the paper where a GPT-4o-mini LLM ranks the performance of RAG systems based on criteria like Comprehensiveness, Diversity, and Empowerment.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Comprehensiveness">
      <data key="d0">Comprehensiveness</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation criterion assessing how thoroughly an answer addresses all aspects and details of a given question.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Diversity">
      <data key="d0">Diversity</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation criterion assessing the variety and richness of an answer in offering different perspectives and insights related to a question.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Empowerment">
      <data key="d0">Empowerment</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation criterion assessing how effectively an answer enables the reader to understand the topic and make informed judgments.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Query Keyword Extraction">
      <data key="d0">Query Keyword Extraction</data>
      <data key="d1">method</data>
      <data key="d2">A step within LightRAG's dual-level retrieval process where both local (specific) and global (broad) keywords are extracted from a given user query.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Keyword Matching">
      <data key="d0">Keyword Matching</data>
      <data key="d1">method</data>
      <data key="d2">A step within LightRAG's retrieval algorithm that uses a vector database to match extracted local and global query keywords with candidate entities and relations.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Incorporating High-Order Relatedness">
      <data key="d0">Incorporating High-Order Relatedness</data>
      <data key="d1">method</data>
      <data key="d2">A step in LightRAG's retrieval process that gathers neighboring nodes within the local subgraphs of retrieved graph elements to enhance the query with higher-order relationships.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Graph Neural Networks (GNNs)">
      <data key="d0">Graph Neural Networks (GNNs)</data>
      <data key="d1">technology</data>
      <data key="d2">A type of neural network specifically designed to operate on graph-structured data, mentioned in the context of LLM-graph integration.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="GNNs as Prefix">
      <data key="d0">GNNs as Prefix</data>
      <data key="d1">concept</data>
      <data key="d2">A category of methods in LLM-graph integration where GNNs are used as an initial processing layer to generate structure-aware tokens for LLMs.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="GraphGPT">
      <data key="d0">GraphGPT</data>
      <data key="d1">technology</data>
      <data key="d2">A specific system mentioned as an example within the 'GNNs as Prefix' category of LLM-graph integration, focusing on graph instruction tuning.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="LLaGA">
      <data key="d0">LLaGA</data>
      <data key="d1">technology</data>
      <data key="d2">A specific system mentioned as an example within the 'GNNs as Prefix' category of LLM-graph integration, described as a 'Large Language and Graph Assistant'.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="LLMs as Prefix">
      <data key="d0">LLMs as Prefix</data>
      <data key="d1">concept</data>
      <data key="d2">A category of methods in LLM-graph integration where LLMs process graph data to refine the training process for GNNs, e.g., by generating node embeddings or labels.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="GALM">
      <data key="d0">GALM</data>
      <data key="d1">technology</data>
      <data key="d2">A specific system mentioned as an example within the 'LLMs as Prefix' category of LLM-graph integration, focusing on graph-aware language model pre-training.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="OFA">
      <data key="d0">OFA</data>
      <data key="d1">technology</data>
      <data key="d2">A specific system mentioned as an example within the 'LLMs as Prefix' category of LLM-graph integration, aiming for a single graph model for all classification tasks.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="LLMs-Graphs Integration">
      <data key="d0">LLMs-Graphs Integration</data>
      <data key="d1">concept</data>
      <data key="d2">A broad category of research focusing on achieving seamless interaction between Large Language Models and graph data, encompassing techniques like fusion training and GNN alignment.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
