    <node id="Logical Reasoning-based Retriever">
      <data key="d0">Logical Reasoning-based Retriever</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval technique that employs symbolic reasoning to deduce and extract pertinent information from graph knowledge bases using logical rules and constraints.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="rule mining">
      <data key="d0">rule mining</data>
      <data key="d1">method</data>
      <data key="d2">A technique used in logical rule-based retrieval to discover logical rules from data.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="inductive logic programming">
      <data key="d0">inductive logic programming</data>
      <data key="d1">method</data>
      <data key="d2">A subfield of artificial intelligence that uses logic programming as a uniform representation for examples, background knowledge, and hypotheses.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="constraint satisfaction">
      <data key="d0">constraint satisfaction</data>
      <data key="d1">method</data>
      <data key="d2">A technique used to find solutions that satisfy a set of constraints, applicable in logical rule-based retrieval.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GNN-based Retriever">
      <data key="d0">GNN-based Retriever</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval technique that utilizes graph neural networks to encode nodes within constructed graph bases, relying on encoding similarity for knowledge localization.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="node classification">
      <data key="d0">node classification</data>
      <data key="d1">task</data>
      <data key="d2">A common task in graph mining where GNNs are applied to classify individual nodes in a graph.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="link prediction">
      <data key="d0">link prediction</data>
      <data key="d1">task</data>
      <data key="d2">A common task in graph mining where GNNs are applied to predict the existence or type of connections between nodes.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="LLM-based Retriever">
      <data key="d0">LLM-based Retriever</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval technique that incorporates LLMs to enhance semantic understanding and contextual relevance, performing query expansion, disambiguation, and tailored path generation.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Reinforcement Learning-based Retriever">
      <data key="d0">Reinforcement Learning-based Retriever</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval technique that frames the retrieval process as a sequential decision-making challenge, allowing an agent to learn and traverse the graph in search of pertinent information.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Deep Q-Networks">
      <data key="d0">Deep Q-Networks</data>
      <data key="d1">method</data>
      <data key="d2">An advanced technique in reinforcement learning used to refine retrieval strategies.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Policy Gradients">
      <data key="d0">Policy Gradients</data>
      <data key="d1">method</data>
      <data key="d2">An advanced technique in reinforcement learning used to refine retrieval strategies.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Actor-Critic">
      <data key="d0">Actor-Critic</data>
      <data key="d1">method</data>
      <data key="d2">An advanced technique in reinforcement learning used to refine retrieval strategies.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="multi-round retrieval">
      <data key="d0">multi-round retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval strategy in GraphRAG systems that incorporates contextual information and user feedback to dynamically refine and adapt the retrieval process.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="post-retrieval">
      <data key="d0">post-retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval strategy where the retrieval process is conducted after the generation to evaluate the faithfulness and accuracy of generated answers, guiding LLM rethinking.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="hybrid retrieval">
      <data key="d0">hybrid retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval strategy that combines different forms of data, such as graphs and other data architectures (e.g., vector databases or online web resources), to collaboratively finish the RAG process.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Graph+Vector RAG">
      <data key="d0">Graph+Vector RAG</data>
      <data key="d1">technology</data>
      <data key="d2">A hybrid retrieval system that combines knowledge graphs and vector databases as retrieval sources for answer generation.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Graph+Online Web Resource RAG">
      <data key="d0">Graph+Online Web Resource RAG</data>
      <data key="d1">technology</data>
      <data key="d2">A hybrid retrieval system that combines knowledge graphs with online web resources for joint retrieval, ensuring timeliness and accuracy of information.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="K2">
      <data key="d0">K2</data>
      <data key="d1">technology</data>
      <data key="d2">A system that explores LLM tuning with multiple retrieval sources, including textual corpus, self-instructed LLM knowledge, and online web resources.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="fine-tuning">
      <data key="d0">fine-tuning</data>
      <data key="d1">method</data>
      <data key="d2">A method of knowledge integration where retrieved information is directly injected into LLMs by adjusting model weights, often using LoRA-based or data-efficient strategies.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="LoRA-based tuning">
      <data key="d0">LoRA-based tuning</data>
      <data key="d1">method</data>
      <data key="d2">A data-efficient fine-tuning strategy that injects retrieved knowledge directly into LLMs.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="in-context learning (ICL)">
      <data key="d0">in-context learning (ICL)</data>
      <data key="d1">method</data>
      <data key="d2">An indirect strategy for knowledge integration in closed-source LLMs, involving careful prompt format choice and LLM response optimization without modifying model parameters.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Node-level Knowledge">
      <data key="d0">Node-level Knowledge</data>
      <data key="d1">concept</data>
      <data key="d2">A granularity level of graph information used for fine-tuning LLMs, focusing on individual nodes and their attributes.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Path-level Knowledge">
      <data key="d0">Path-level Knowledge</data>
      <data key="d1">concept</data>
      <data key="d2">A granularity level of graph information used for fine-tuning LLMs, concentrating on connections and sequences between nodes (reasoning paths).</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Subgraph-level Knowledge">
      <data key="d0">Subgraph-level Knowledge</data>
      <data key="d1">concept</data>
      <data key="d2">A granularity level of graph information used for fine-tuning LLMs, considering larger structures composed of multiple nodes and their interconnections.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="SKETCH">
      <data key="d0">SKETCH</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with node-level knowledge, concatenating node attributes as input.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GLRec">
      <data key="d0">GLRec</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with path-level knowledge, calculating path weights from user-item descriptions.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="KGTransformer">
      <data key="d0">KGTransformer</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs using sampled knowledge graph sequences for path-level knowledge.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="MuseGraph">
      <data key="d0">MuseGraph</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with path-level knowledge, utilizing node paths and attributes with Chain-of-Thought.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="RHO">
      <data key="d0">RHO</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with subgraph-level knowledge, using KG embeddings and subgraphs directly.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GNP">
      <data key="d0">GNP</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with subgraph-level knowledge, integrating graph and query embeddings.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="InstructGLM">
      <data key="d0">InstructGLM</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with subgraph-level knowledge, flattening subgraphs to sequences with node attributes and graph embeddings.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="LLAGA">
      <data key="d0">LLAGA</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with subgraph-level knowledge, flattening subgraphs to sequences with node attributes and graph embeddings.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Chain-of-Thought (CoT)">
      <data key="d0">Chain-of-Thought (CoT)</data>
      <data key="d1">method</data>
      <data key="d2">A prompting technique that encourages LLMs to generate a series of intermediate reasoning steps to arrive at a final answer, enhancing complex multi-hop reasoning.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Think-on-Graph">
      <data key="d0">Think-on-Graph</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG reasoning framework based on KG-LLM interaction, where LLMs retrieve relevant subgraphs and deduce final results through chain reasoning.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Graph CoT">
      <data key="d0">Graph CoT</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system where LLMs reason key components in external graphs and use multi-round graph execution and interaction to finish chain reasoning.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Chain-of-Knowledge">
      <data key="d0">Chain-of-Knowledge</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that constructs exemplars based on evidence triples from a knowledge base and verifies the reliability of chain predictions.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Program-of-Thought (PoT)">
      <data key="d0">Program-of-Thought (PoT)</data>
      <data key="d1">method</data>
      <data key="d2">A prompting technique that extends Chain-of-Thought into coding scenarios, used in GraphRAG to generate research language for knowledge bases.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="KG-based Retrofitting">
      <data key="d0">KG-based Retrofitting</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that combines LLMs with KGs to mitigate hallucination by retrofitting initial draft responses based on factual knowledge in KGs.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="Explore-then-Determine framework">
      <data key="d0">Explore-then-Determine framework</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that uses the integration of LLMs and KGs to determine the final answer in a collaborative manner.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="CogMG">
      <data key="d0">CogMG</data>
      <data key="d1">technology</data>
      <data key="d2">A framework for collaborative augmentation between LLMs and KGs, leveraging KGs to augment LLMs in generations and enriching KGs with identified missing knowledge.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="MedPaLM">
      <data key="d0">MedPaLM</data>
      <data key="d1">technology</data>
      <data key="d2">A domain-specific LLM built upon PaLM, demonstrating exceptional performance in complex medical tasks using prompting strategies.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="PaLM">
      <data key="d0">PaLM</data>
      <data key="d1">technology</data>
      <data key="d2">A foundational large language model upon which domain-specific models like MedPaLM are built.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="IM-RAG">
      <data key="d0">IM-RAG</data>
      <data key="d1">technology</data>
      <data key="d2">An approach integrating retrieval systems with LLMs to support multi-round Retrieval-Augmented Generation (RAG) by learning Inner Monologues.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Inner Monologues">
      <data key="d0">Inner Monologues</data>
      <data key="d1">concept</data>
      <data key="d2">A concept in IM-RAG akin to human internal thought processes, used to guide multi-round interactions for LLM refinement.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
