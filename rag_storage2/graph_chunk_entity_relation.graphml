      <data key="d5">1753718183</data>
    </node>
    <node id="Jonathan Larson">
      <data key="d0">Jonathan Larson</data>
      <data key="d1">person</data>
      <data key="d2">Co-author of the paper 'From Local to Global: A GraphRAG Approach to Query-Focused Summarization', co-creator of the Claimify method, and affiliated with Microsoft Research.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Kevin Scott">
      <data key="d0">Kevin Scott</data>
      <data key="d1">person</data>
      <data key="d2">Microsoft CTO and host of the podcast 'Behind the Tech', which provided one of the datasets used in the study.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Microsoft Research">
      <data key="d0">Microsoft Research</data>
      <data key="d1">organization</data>
      <data key="d2">A research division of Microsoft, affiliated with several authors of the paper, and where the research was conducted.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Microsoft Strategic Missions and Technologies">
      <data key="d0">Microsoft Strategic Missions and Technologies</data>
      <data key="d1">organization</data>
      <data key="d2">A division of Microsoft, affiliated with several authors of the paper.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Microsoft Office of the CTO">
      <data key="d0">Microsoft Office of the CTO</data>
      <data key="d1">organization</data>
      <data key="d2">The office of the Chief Technology Officer at Microsoft, affiliated with several authors of the paper.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="OpenAI">
      <data key="d0">OpenAI</data>
      <data key="d1">organization</data>
      <data key="d2">A prominent AI research and deployment company, known for developing large language models like GPT and GPT-4, which are referenced and used in the study.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Google">
      <data key="d0">Google</data>
      <data key="d1">organization</data>
      <data key="d2">A technology company whose models, such as Gemini, are referenced as examples of large language models excelling at sensemaking.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Large Language Models (LLMs)">
      <data key="d0">Large Language Models (LLMs)</data>
      <data key="d1">technology</data>
      <data key="d2">Advanced AI models capable of processing and generating human-like text, which RAG systems aim to augment with external knowledge.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Retrieval-Augmented Generation (RAG)">
      <data key="d0">Retrieval-Augmented Generation (RAG)</data>
      <data key="d1">method</data>
      <data key="d2">An established approach that combines large language models with external knowledge sources to answer queries based on data too large to fit into a model's context window.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="GraphRAG">
      <data key="d0">GraphRAG</data>
      <data key="d1">method</data>
      <data key="d2">A graph-enhanced RAG system used as a baseline that extracts entities and relationships, aggregates nodes into communities, and retrieves information by traversing these communities.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753718213</data>
    </node>
    <node id="Vector RAG">
      <data key="d0">Vector RAG</data>
      <data key="d1">method</data>
      <data key="d2">A conventional retrieval-augmented generation (RAG) approach that typically uses text embeddings to retrieve records semantically similar to a query.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="GPT">
      <data key="d0">GPT</data>
      <data key="d1">technology</data>
      <data key="d2">A family of large language models developed by OpenAI, mentioned for their capability in sensemaking.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="GPT-4">
      <data key="d0">GPT-4</data>
      <data key="d1">technology</data>
      <data key="d2">A specific, highly capable large language model from OpenAI, used as the underlying LLM in the GraphRAG experiments and evaluation.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Llama">
      <data key="d0">Llama</data>
      <data key="d1">technology</data>
      <data key="d2">A family of open foundation and fine-tuned chat models, referenced for their capability in sensemaking.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Gemini">
      <data key="d0">Gemini</data>
      <data key="d1">technology</data>
      <data key="d2">A family of highly capable multimodal models, referenced for their capability in sensemaking.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="LangChain">
      <data key="d0">LangChain</data>
      <data key="d1">technology</data>
      <data key="d2">An open-source framework for developing applications powered by language models, which offers extensions for the GraphRAG approach.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="LlamaIndex">
      <data key="d0">LlamaIndex</data>
      <data key="d1">technology</data>
      <data key="d2">A data framework for building LLM applications, which offers GraphRAG implementation examples.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="NebulaGraph">
      <data key="d0">NebulaGraph</data>
      <data key="d1">technology</data>
      <data key="d2">An open-source graph database that has launched industry-first GraphRAG extensions.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Neo4J">
      <data key="d0">Neo4J</data>
      <data key="d1">technology</data>
      <data key="d2">A popular graph database platform that offers ecosystem tools for GraphRAG.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Claimify">
      <data key="d0">Claimify</data>
      <data key="d1">technology</data>
      <data key="d2">An LLM-based method developed by Metropolitansky and Larson, used in the research to identify factual claims within generated answers for quantitative evaluation.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Scikit-learn">
      <data key="d0">Scikit-learn</data>
      <data key="d1">technology</data>
      <data key="d2">A popular machine learning library in Python, whose implementation of agglomerative clustering was used in the research for diversity measurement.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="OpenORD">
      <data key="d0">OpenORD</data>
      <data key="d1">technology</data>
      <data key="d2">An open-source toolbox for large graph layout, used for node layout visualization in the study.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Force Atlas 2">
      <data key="d0">Force Atlas 2</data>
      <data key="d1">technology</data>
      <data key="d2">A continuous graph layout algorithm, used for node layout visualization in the study.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Query-Focused Summarization (QFS)">
      <data key="d0">Query-Focused Summarization (QFS)</data>
      <data key="d1">concept</data>
      <data key="d2">A task where a summary is generated specifically to answer a given query over an entire text corpus.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Sensemaking">
      <data key="d0">Sensemaking</data>
      <data key="d1">concept</data>
      <data key="d2">The process of creating understanding by reasoning over connections among people, places, and events to anticipate trajectories and act effectively, a key focus for GraphRAG.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Context Window">
      <data key="d0">Context Window</data>
      <data key="d1">concept</data>
      <data key="d2">The maximum number of tokens (units of text) that a large language model can process at once, a limitation RAG addresses.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Entity Knowledge Graph">
      <data key="d0">Entity Knowledge Graph</data>
      <data key="d1">concept</data>
      <data key="d2">A structured representation of information where nodes correspond to key entities in a corpus and edges represent relationships between them, built by GraphRAG.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Community Summaries">
      <data key="d0">Community Summaries</data>
      <data key="d1">concept</data>
      <data key="d2">Pre-generated summaries for groups of closely related entities within a knowledge graph, used by GraphRAG to provide global descriptions and insights.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Text Embeddings">
      <data key="d0">Text Embeddings</data>
      <data key="d1">concept</data>
      <data key="d2">Numerical representations of text that capture semantic similarity, commonly used in conventional RAG approaches for retrieval.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Adaptive Benchmarking">
      <data key="d0">Adaptive Benchmarking</data>
      <data key="d1">method</data>
      <data key="d2">The process of dynamically generating evaluation benchmarks tailored to specific domains or use cases, used to create global sensemaking queries.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="LLM-as-a-judge">
      <data key="d0">LLM-as-a-judge</data>
      <data key="d1">method</data>
      <data key="d2">A technique where a large language model is used to evaluate the answers of other RAG systems based on predefined criteria, employed for evaluation in the study.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Comprehensiveness (Criterion)">
      <data key="d0">Comprehensiveness (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation criterion measuring how much detail an answer provides to cover all aspects of a given question, assessed via LLM-as-a-judge and claim-based metrics.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Diversity (Criterion)">
      <data key="d0">Diversity (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation criterion measuring how varied and rich an answer is in providing different perspectives and insights on a question, assessed via LLM-as-a-judge and claim-based metrics.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Empowerment (Criterion)">
      <data key="d0">Empowerment (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation criterion assessing how well an answer helps the reader understand and make informed judgments about the topic without being misled.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Directness (Criterion)">
      <data key="d0">Directness (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">A control evaluation criterion assessing how specifically and clearly an answer addresses the question, used as a reference point for other criteria.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Factual Claims">
      <data key="d0">Factual Claims</data>
      <data key="d1">concept</data>
      <data key="d2">Statements that explicitly present verifiable facts, used as a basis for quantitative claim-based measures of comprehensiveness and diversity.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Graph-based Approach">
      <data key="d0">Graph-based Approach</data>
      <data key="d1">method</data>
      <data key="d2">A methodology utilizing graph structures for question answering over text corpora, distinguishing GraphRAG from conventional RAG.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Map-reduce Processing">
      <data key="d0">Map-reduce Processing</data>
      <data key="d1">method</data>
      <data key="d2">A programming model used by GraphRAG for multi-stage summarization, where partial answers are generated (map) and then combined into a final global answer (reduce).</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Community Detection">
      <data key="d0">Community Detection</data>
      <data key="d1">method</data>
      <data key="d2">Algorithms used to partition graphs into communities of strongly connected nodes, such as Leiden, applied in GraphRAG to organize entities.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Leiden Community Detection">
      <data key="d0">Leiden Community Detection</data>
      <data key="d1">method</data>
      <data key="d2">A specific community detection algorithm used hierarchically in the GraphRAG pipeline to partition the graph into nested communities.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Agglomerative Clustering">
      <data key="d0">Agglomerative Clustering</data>
      <data key="d1">method</data>
      <data key="d2">A hierarchical clustering algorithm used in Experiment 2 to cluster extracted claims for measuring diversity.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Wilcoxon Signed-Rank Tests">
      <data key="d0">Wilcoxon Signed-Rank Tests</data>
      <data key="d1">method</data>
      <data key="d2">A non-parametric statistical test employed to assess the performance differences between pairs of conditions in the evaluation.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Holm-Bonferroni Correction">
      <data key="d0">Holm-Bonferroni Correction</data>
      <data key="d1">method</data>
      <data key="d2">A statistical method applied to adjust p-values for multiple pairwise comparisons, ensuring the control of family-wise error rate.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Persona Generation">
      <data key="d0">Persona Generation</data>
      <data key="d1">method</data>
      <data key="d2">An LLM-based method used in adaptive benchmarking to infer hypothetical users and their use cases, guiding the generation of corpus-specific sensemaking queries.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="In-context Learning">
      <data key="d0">In-context Learning</data>
      <data key="d1">method</data>
      <data key="d2">A technique where language models learn from examples provided directly in the prompt, used to tailor entity extraction prompts to specific domains.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Entity Matching">
      <data key="d0">Entity Matching</data>
      <data key="d1">method</data>
      <data key="d2">The task of reconciling different extracted names for the same entity, mentioned as a process in knowledge graph construction.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Self-reflection (Prompt Engineering)">
      <data key="d0">Self-reflection (Prompt Engineering)</data>
      <data key="d1">method</data>
      <data key="d2">A prompt engineering technique where an LLM evaluates its own output and generates an improved response, used to enhance knowledge graph extraction quality.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Hierarchical Indexing">
      <data key="d0">Hierarchical Indexing</data>
      <data key="d1">method</data>
      <data key="d2">An approach similar to GraphRAG where data is organized into a hierarchy to create summaries, leveraging community structures for this purpose.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="ROUGE-L">
      <data key="d0">ROUGE-L</data>
      <data key="d1">method</data>
      <data key="d2">A metric used to evaluate text summarization and machine translation, applied as a distance metric in clustering factual claims.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="HotPotQA">
      <data key="d0">HotPotQA</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset for diverse, explainable multi-hop question answering, used in preliminary tests for entity extraction.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="MultiHop-RAG">
      <data key="d0">MultiHop-RAG</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset for evaluating retrieval-augmented generation for multi-hop queries, mentioned as a common benchmark.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="MT-Bench">
      <data key="d0">MT-Bench</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset used for evaluating the performance of LLM-as-a-judge systems.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="Podcast Transcripts (Behind the Tech with Kevin Scott)">
      <data key="d0">Podcast Transcripts (Behind the Tech with Kevin Scott)</data>
      <data key="d1">dataset</data>
      <data key="d2">A real-world dataset consisting of public transcripts from a podcast, used as one of the two main evaluation corpora in Experiment 1.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
    <node id="News Articles (Benchmark Dataset)">
      <data key="d0">News Articles (Benchmark Dataset)</data>
      <data key="d1">dataset</data>
      <data key="d2">A real-world dataset comprised of news articles published from September 2013 to December 2023, used as one of the two main evaluation corpora in Experiment 1.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753718183</data>
    </node>
