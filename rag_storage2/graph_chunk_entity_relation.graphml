      <data key="d5">1753720206</data>
    </node>
    <node id="Ruoxi Chen">
      <data key="d0">Ruoxi Chen</data>
      <data key="d1">person</data>
      <data key="d2">An author of the paper.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Lichao Sun">
      <data key="d0">Lichao Sun</data>
      <data key="d1">person</data>
      <data key="d2">An author of the paper, affiliated with Lehigh University.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Columbia University">
      <data key="d0">Columbia University</data>
      <data key="d1">organization</data>
      <data key="d2">An academic institution, affiliation of several authors of the paper.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="University of Pennsylvania">
      <data key="d0">University of Pennsylvania</data>
      <data key="d1">organization</data>
      <data key="d2">An academic institution, affiliation of an author of the paper.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Lehigh University">
      <data key="d0">Lehigh University</data>
      <data key="d1">organization</data>
      <data key="d2">An academic institution, affiliation of several authors of the paper.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph-based RAG methods">
      <data key="d0">graph-based RAG methods</data>
      <data key="d1">method</data>
      <data key="d2">Approaches that enrich the RAG process by building a knowledge graph index and leveraging the structural nature of graphs.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="knowledge graph index">
      <data key="d0">knowledge graph index</data>
      <data key="d1">concept</data>
      <data key="d2">A structured representation of information where entities and their relationships are stored as a graph, used by graph-based RAG methods.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="multi-hop benchmarks">
      <data key="d0">multi-hop benchmarks</data>
      <data key="d1">dataset</data>
      <data key="d2">Evaluation datasets used to test the performance of RAG methods on queries requiring reasoning across multiple pieces of information.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="real-world knowledge domains">
      <data key="d0">real-world knowledge domains</data>
      <data key="d1">concept</data>
      <data key="d2">Areas of information that are constantly evolving, posing challenges for static LLMs.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="external retrieval mechanism">
      <data key="d0">external retrieval mechanism</data>
      <data key="d1">technology</data>
      <data key="d2">A component that allows LLMs to retrieve information from outside their pre-trained knowledge base.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="multi-hop reasoning">
      <data key="d0">multi-hop reasoning</data>
      <data key="d1">concept</data>
      <data key="d2">A type of complex query answering that requires combining information from multiple discrete sources or steps.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="summary-level queries">
      <data key="d0">summary-level queries</data>
      <data key="d1">concept</data>
      <data key="d2">Queries that require synthesizing information to provide a high-level summary rather than specific facts.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="data structures">
      <data key="d0">data structures</data>
      <data key="d1">concept</data>
      <data key="d2">Organized ways of storing and managing data, whose insufficient utilization can impede RAG performance.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="structural information">
      <data key="d0">structural information</data>
      <data key="d1">concept</data>
      <data key="d2">Information derived from the relationships and organization of data, as opposed to raw text content.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="knowledge graphs (KGs)">
      <data key="d0">knowledge graphs (KGs)</data>
      <data key="d1">concept</data>
      <data key="d2">Graphs that extract triples (subject-predicate-object) to represent structural information, often used in graph-based RAG.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="triples">
      <data key="d0">triples</data>
      <data key="d1">concept</data>
      <data key="d2">Fundamental units of information in knowledge graphs, consisting of a subject, predicate, and object.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="entity-event homogeneous structure">
      <data key="d0">entity-event homogeneous structure</data>
      <data key="d1">concept</data>
      <data key="d2">A type of graph structure used by some RAG methods (e.g., GraphRAG) where entities and events are represented uniformly, potentially hindering integration of diverse information.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="local retrieval">
      <data key="d0">local retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval approach focusing on information closely associated with a specific query or entity.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="global retrieval">
      <data key="d0">global retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval approach that considers broader context or aggregated information, often from communities or summaries within a graph.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="coarse-grained retrieval">
      <data key="d0">coarse-grained retrieval</data>
      <data key="d1">concept</data>
      <data key="d2">A retrieval outcome where the retrieved information is broad and may include irrelevant details, lacking specificity.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Heterogeneous Graph">
      <data key="d0">Heterogeneous Graph</data>
      <data key="d1">concept</data>
      <data key="d2">The core graph structure proposed by NodeRAG, featuring distinct node types (entities, relationships, text chunks, events, summaries) to enable fine-grained and holistic information representation.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph algorithms">
      <data key="d0">graph algorithms</data>
      <data key="d1">method</data>
      <data key="d2">Computational procedures applied to graphs to solve problems, used in NodeRAG for identifying key nodes and enabling fine-grained retrieval.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Better Graph Structure for RAG">
      <data key="d0">Better Graph Structure for RAG</data>
      <data key="d1">concept</data>
      <data key="d2">A key contribution of NodeRAG, emphasizing the importance of and introducing an improved graph structure to better support RAG.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Fine-grained and Explainable Retrieval">
      <data key="d0">Fine-grained and Explainable Retrieval</data>
      <data key="d1">concept</data>
      <data key="d2">A key contribution of NodeRAG, enabled by the heterograph and graph algorithms, leading to more relevant retrieval with minimal context and enhanced interpretability.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Unified-Level Information Retrieval">
      <data key="d0">Unified-Level Information Retrieval</data>
      <data key="d1">concept</data>
      <data key="d2">A key contribution of NodeRAG, where decomposed document information and LLM-extracted insights are unified as nodes within the heterograph for cohesive information handling.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="indexing time">
      <data key="d0">indexing time</data>
      <data key="d1">concept</data>
      <data key="d2">A performance metric referring to the time taken to build the graph index from the source corpus.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="query time">
      <data key="d0">query time</data>
      <data key="d1">concept</data>
      <data key="d2">A performance metric referring to the time taken to retrieve information from the indexed graph in response to a query.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="storage efficiency">
      <data key="d0">storage efficiency</data>
      <data key="d1">concept</data>
      <data key="d2">A performance metric referring to how effectively data is stored, minimizing the required storage space for the graph index.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph indexing">
      <data key="d0">graph indexing</data>
      <data key="d1">method</data>
      <data key="d2">The first primary stage of the NodeRAG workflow, comprising graph decomposition, graph augmentation, and graph enrichment, to integrate various types of nodes and edges into the heterograph.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph decomposition">
      <data key="d0">graph decomposition</data>
      <data key="d1">method</data>
      <data key="d2">A component of graph indexing in NodeRAG, where text chunks are decomposed into primary node types like semantic units, entities, and relationships.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph augmentation">
      <data key="d0">graph augmentation</data>
      <data key="d1">method</data>
      <data key="d2">A component of graph indexing in NodeRAG, which enhances the foundational graph structure by adding high-level organization and contextual insights.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph enrichment">
      <data key="d0">graph enrichment</data>
      <data key="d1">method</data>
      <data key="d2">A component of graph indexing in NodeRAG, which adds unique and additional details to the heterograph, such as original text insertion and HNSW semantic edges.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="graph searching">
      <data key="d0">graph searching</data>
      <data key="d1">method</data>
      <data key="d2">The subsequent stage of the NodeRAG workflow, combining the structural advantages of the heterograph with graph algorithms to efficiently retrieve relevant information.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="prompting instructions">
      <data key="d0">prompting instructions</data>
      <data key="d1">concept</data>
      <data key="d2">Guidelines or specific text used to direct the behavior and output of large language models.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="entity (N)">
      <data key="d0">entity (N)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing named entities (e.g., people, places, concepts). It is non-retrievable and acts solely as a critical linkage and entry point within the graph.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="relationship (R)">
      <data key="d0">relationship (R)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing connections between entities. It is retrievable and functions as a connector node and a secondary retrievable node.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="semantic unit (S)">
      <data key="d0">semantic unit (S)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing a local summary or an independent event unit paraphrased from text chunks. It is retrievable and serves as a core node for graph augmentation and improving search quality.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="attribute (A)">
      <data key="d0">attribute (A)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing attribute summaries of key entities, derived from relationships and semantic units around important entities. It is retrievable.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="high-level elements (H)">
      <data key="d0">high-level elements (H)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing insights summarizing graph communities, encapsulating core information or high-level ideas from a community. It is retrievable.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="high-level overview (O)">
      <data key="d0">high-level overview (O)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing titles or keywords summarizing high-level elements. It is non-retrievable and used for accurate search entry points.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="text (T)">
      <data key="d0">text (T)</data>
      <data key="d1">concept</data>
      <data key="d2">A type of node in NodeRAG's heterograph representing full-text chunks from the original source corpus. It is retrievable and contains rich detailed information.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="retrievable nodes">
      <data key="d0">retrievable nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Nodes in the heterograph (T, S, A, H, R) that contain rich informational content and can be directly retrieved as part of the answer.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="non-retrievable nodes">
      <data key="d0">non-retrievable nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Nodes in the heterograph (N, O) that primarily serve as linkage or entry points and do not directly contribute to the retrieved content.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="text chunks">
      <data key="d0">text chunks</data>
      <data key="d1">concept</data>
      <data key="d2">Smaller segments of text from the source corpus that are processed by LLMs in NodeRAG for graph decomposition.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="context noise">
      <data key="d0">context noise</data>
      <data key="d1">concept</data>
      <data key="d2">Irrelevant or unassociated content within a text chunk that can degrade search quality.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="node importance-based augmentation">
      <data key="d0">node importance-based augmentation</data>
      <data key="d1">method</data>
      <data key="d2">A method within graph augmentation that prioritizes selecting structurally significant and functionally pivotal entities for generating attribute summaries.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="community detection-based aggregation">
      <data key="d0">community detection-based aggregation</data>
      <data key="d1">method</data>
      <data key="d2">A method within graph augmentation that applies community detection algorithms to segment the graph and extract high-level elements for each community.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="K-core decomposition">
      <data key="d0">K-core decomposition</data>
      <data key="d1">method</data>
      <data key="d2">A graph metric used in NodeRAG to identify nodes in densely connected subgraphs that are critical to graph cohesion.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="betweenness centrality">
      <data key="d0">betweenness centrality</data>
      <data key="d1">method</data>
      <data key="d2">A graph metric used in NodeRAG to highlight nodes that act as bridges for information flow, identifying critical intermediaries.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Leiden algorithm">
      <data key="d0">Leiden algorithm</data>
      <data key="d1">method</data>
      <data key="d2">A community detection algorithm mentioned as an alternative to the label propagation algorithm, but not chosen for Zep's dynamic community extension due to its complexity.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="K-means clustering">
      <data key="d0">K-means clustering</data>
      <data key="d1">method</data>
      <data key="d2">A clustering algorithm applied in NodeRAG to embeddings of semantic units, attributes, and high-level elements to identify semantically related nodes within communities.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="semantic matching within community algorithm">
      <data key="d0">semantic matching within community algorithm</data>
      <data key="d1">method</data>
      <data key="d2">An algorithm proposed in NodeRAG to establish meaningful connections between high-level element nodes and relevant nodes from the graph within the same community based on semantic similarity.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Hierarchical Navigable Small World (HNSW) algorithm">
      <data key="d0">Hierarchical Navigable Small World (HNSW) algorithm</data>
      <data key="d1">method</data>
      <data key="d2">An approximate nearest neighbor search method used in NodeRAG to organize data into a multi-layer graph structure, enabling efficient retrieval of semantically similar nodes and integrated into the heterograph as semantic edges.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="approximate nearest neighbor search">
      <data key="d0">approximate nearest neighbor search</data>
      <data key="d1">concept</data>
      <data key="d2">A class of algorithms that efficiently find points in a high-dimensional space that are approximately closest to a given query point.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="cosine similarity">
      <data key="d0">cosine similarity</data>
      <data key="d1">concept</data>
      <data key="d2">A measure of similarity between two non-zero vectors of an inner product space, often used in information retrieval to determine how similar two documents or vectors are.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="dual search mechanism">
      <data key="d0">dual search mechanism</data>
      <data key="d1">method</data>
      <data key="d2">A mechanism in NodeRAG that combines exact matching on title nodes and vector similarity search on rich information nodes to identify initial entry points in the heterograph.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Personalized PageRank (PPR) algorithm">
      <data key="d0">Personalized PageRank (PPR) algorithm</data>
      <data key="d1">method</data>
      <data key="d2">A graph algorithm used in NodeRAG to identify relevant nodes by simulating a biased random walk starting from a set of entry points, refined for shallow execution.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="shallow PPR">
      <data key="d0">shallow PPR</data>
      <data key="d1">method</data>
      <data key="d2">A variant of Personalized PageRank used in NodeRAG that limits the number of iterations to ensure relevance remains localized to the neighborhoods of entry points, preventing excessive diffusion.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="cross nodes">
      <data key="d0">cross nodes</data>
      <data key="d1">concept</data>
      <data key="d2">Nodes identified by shallow PPR as closely related to entry points, included in the final retrieval results.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="HotpotQA">
      <data key="d0">HotpotQA</data>
      <data key="d1">Dataset</data>
      <data key="d2">A dataset used for evaluating token costs in the generation stage, likely focused on multi-hop question answering.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="MuSiQue">
      <data key="d0">MuSiQue</data>
      <data key="d1">dataset</data>
      <data key="d2">A multi-hop question-answering dataset used to evaluate NodeRAG's performance, challenging models to combine information across multiple documents step-by-step.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="RAG-QA Arena">
      <data key="d0">RAG-QA Arena</data>
      <data key="d1">dataset</data>
      <data key="d2">An open-ended head-to-head evaluation framework used to assess the quality of retrieval-augmented generation systems on long-form question answering across six domains.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="accuracy (Acc)">
      <data key="d0">accuracy (Acc)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric measuring the correctness of answers generated by RAG methods.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="average number of retrieved tokens (#Token)">
      <data key="d0">average number of retrieved tokens (#Token)</data>
      <data key="d1">concept</data>
      <data key="d2">An efficiency metric measuring the average quantity of tokens retrieved by RAG methods.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Score (Sco)">
      <data key="d0">Score (Sco)</data>
      <data key="d1">concept</data>
      <data key="d2">The original evaluation metric adopted for the MultiHop-RAG benchmark.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="win and tie ratio (W+T)">
      <data key="d0">win and tie ratio (W+T)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric used in RAG-QA Arena to compare a system's generated answer against gold responses.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="GPT 4o-mini">
      <data key="d0">GPT 4o-mini</data>
      <data key="d1">technology</data>
      <data key="d2">A large language model used to implement the RAG methods in the evaluation.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="model temperature">
      <data key="d0">model temperature</data>
      <data key="d1">concept</data>
      <data key="d2">A hyperparameter in LLMs that controls the randomness of output, influencing consistency and creativity.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="ablation experiments">
      <data key="d0">ablation experiments</data>
      <data key="d1">method</data>
      <data key="d2">Experiments conducted to assess the impact of individual components of NodeRAG by systematically removing them.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="top-k vector similarity method">
      <data key="d0">top-k vector similarity method</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval method that selects the 'k' most similar items based on vector embeddings, used as a comparison in ablation studies.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="JPR">
      <data key="d0">JPR</data>
      <data key="d1">method</data>
      <data key="d2">A RAG method that improves multi-answer retrieval by refining passage selection.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="IR-CoT">
      <data key="d0">IR-CoT</data>
      <data key="d1">method</data>
      <data key="d2">A RAG method that integrates chain-of-thought reasoning for multi-hop question answering.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Tree of Clarifications">
      <data key="d0">Tree of Clarifications</data>
      <data key="d1">method</data>
      <data key="d2">A RAG method that constructs a tree-based disambiguation structure to resolve ambiguous queries.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="dense retrieval">
      <data key="d0">dense retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval method that relies on vector embeddings to find similar documents.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="context window limitations">
      <data key="d0">context window limitations</data>
      <data key="d1">concept</data>
      <data key="d2">A constraint in LLMs referring to the maximum amount of text they can process at once, impacting their ability to handle extensive external documents.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="BioRAG">
      <data key="d0">BioRAG</data>
      <data key="d1">method</data>
      <data key="d2">A RAG-LLM framework specifically designed for biological question reasoning.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="MedicalRAG">
      <data key="d0">MedicalRAG</data>
      <data key="d1">method</data>
      <data key="d2">A RAG method applied to medical LLM systems via graph retrieval-augmented generation.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="corpus-wide understanding tasks">
      <data key="d0">corpus-wide understanding tasks</data>
      <data key="d1">concept</data>
      <data key="d2">Tasks that require synthesizing knowledge across large datasets rather than just retrieving specific facts.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="query-focused abstractive summarization">
      <data key="d0">query-focused abstractive summarization</data>
      <data key="d1">concept</data>
      <data key="d2">A task that involves generating a concise, high-level summary of information from a corpus, tailored to a specific query, which RAG sometimes struggles with.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Dense Hierarchical Retrieval (DHR)">
      <data key="d0">Dense Hierarchical Retrieval (DHR)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval method that improves passage representations by combining macroscopic document semantics with microscopic passage details.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Hybrid Hierarchical Retrieval (HHR)">
      <data key="d0">Hybrid Hierarchical Retrieval (HHR)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval method that fuses sparse and dense retrieval techniques for both document- and passage-level retrieval to achieve greater precision.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="RAPTOR">
      <data key="d0">RAPTOR</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="KAPING">
      <data key="d0">KAPING</data>
      <data key="d1">method</data>
      <data key="d2">A graph-based RAG method that refines knowledge organization and retrieval efficiency.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="community-based summaries">
      <data key="d0">community-based summaries</data>
      <data key="d1">concept</data>
      <data key="d2">Aggregated summaries generated for detected communities within a graph, used by methods like GraphRAG.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="text embeddings">
      <data key="d0">text embeddings</data>
      <data key="d1">concept</data>
      <data key="d2">Numerical representations of text that capture semantic meaning, allowing for vector space comparisons.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="top-k parameter">
      <data key="d0">top-k parameter</data>
      <data key="d1">concept</data>
      <data key="d2">A hyperparameter used in retrieval methods to specify the number of most relevant items (e.g., text chunks, tokens) to retrieve.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="LLM-as-a-Judge approach">
      <data key="d0">LLM-as-a-Judge approach</data>
      <data key="d1">method</data>
      <data key="d2">An evaluation methodology where large language models are used to assess the quality of generated answers by other models.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
