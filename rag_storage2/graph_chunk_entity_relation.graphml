      <data key="d0">Tu Ao</data>
      <data key="d1">person</data>
      <data key="d2">An author of the LightRAG research paper, affiliated with Beijing University of Posts and Telecommunications.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
