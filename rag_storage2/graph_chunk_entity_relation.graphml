      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Antgroup">
      <data key="d0">Antgroup</data>
      <data key="d1">organization</data>
      <data key="d2">A technology company that developed an industrial GraphRAG framework built on various AI engineering and graph database frameworks.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="DB-GPT">
