    <node id="Depth-First Search (DFS)">
      <data key="d0">Depth-First Search (DFS)</data>
      <data key="d1">method</data>
      <data key="d2">A graph traversal algorithm used in Antgroup's GraphRAG system during the retrieval phase to locate and traverse subgraphs.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Neo4j">
      <data key="d0">Neo4j</data>
      <data key="d1">technology</data>
      <data key="d2">A leading graph database system used by Zep for its implementation of Lucene for cosine similarity and full-text search functions.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
