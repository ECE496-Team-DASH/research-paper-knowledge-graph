      <data key="d1">technology</data>
      <data key="d2">A GraphRAG method that introduces a lightweight multilayer perceptron to extract subgraphs, balancing precision and recall in reasoning chain retrieval.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="GoR">
      <data key="d0">GoR</data>
      <data key="d1">technology</data>
      <data key="d2">A Hybrid GraphRAG method that constructs a graph by creating nodes for text chunks and LLM-generated responses to simulated queries for long-context summarization.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
