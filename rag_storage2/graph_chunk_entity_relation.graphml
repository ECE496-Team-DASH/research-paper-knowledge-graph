      <data key="d1">method</data>
      <data key="d2">A natural language processing task that identifies mentions in text that refer to the same real-world entity, used in KG construction.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="AutoKG">
      <data key="d0">AutoKG</data>
      <data key="d1">technology</data>
