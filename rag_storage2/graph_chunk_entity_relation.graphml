    <node id="LLM (Large Language Model)">
      <data key="d0">LLM (Large Language Model)</data>
      <data key="d1">technology</data>
      <data key="d2">A pre-trained model capable of processing and generating human-like text, refined through fine-tuning for domain-specific tasks.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Fine-tuning">
      <data key="d0">Fine-tuning</data>
      <data key="d1">method</data>
      <data key="d2">A process of refining the weights of a pre-trained LLM by training it on a smaller, annotated dataset with a slow learning rate to adopt new knowledge.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Transfer learning">
      <data key="d0">Transfer learning</data>
      <data key="d1">concept</data>
      <data key="d2">A machine learning technique that allows a pre-trained model to apply its knowledge to a new task, especially useful when sufficient datasets for fine-tuning are unavailable.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Prompting strategies">
      <data key="d0">Prompting strategies</data>
      <data key="d1">method</data>
      <data key="d2">Techniques used to guide LLMs by formulating inputs, such as with annotated medical questions and answers for MedPaLM.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Multi-round integration">
      <data key="d0">Multi-round integration</data>
      <data key="d1">method</data>
      <data key="d2">A technique enhancing LLM response quality through iterative refinement of retrieved information and enabling multi-hop complex reasoning.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="RAG (Retrieval-Augmented Generation)">
      <data key="d0">RAG (Retrieval-Augmented Generation)</data>
      <data key="d1">technology</data>
      <data key="d2">A framework that enhances LLMs by integrating them with external knowledge bases to improve domain-specific capabilities.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Multi-hop complex reasoning">
      <data key="d0">Multi-hop complex reasoning</data>
      <data key="d1">concept</data>
      <data key="d2">A reasoning task requiring multiple intermediate steps to answer complex questions, often challenging for LLMs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="X-InSTA">
      <data key="d0">X-InSTA</data>
      <data key="d1">method</data>
      <data key="d2">A method proposing a cross-lingual in-context source-target alignment strategy to align prompt examples in cross-lingual scenarios.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="AgentPS">
      <data key="d0">AgentPS</data>
      <data key="d1">technology</data>
      <data key="d2">A framework integrating agentic process supervision into LLMs via multi-round question answering for multimodal content quality assurance.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Process supervision">
      <data key="d0">Process supervision</data>
      <data key="d1">concept</data>
      <data key="d2">A method of guiding and evaluating a model's intermediate reasoning steps to improve output quality, integrated by frameworks like AgentPS.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Structured sequential reasoning">
      <data key="d0">Structured sequential reasoning</data>
      <data key="d1">concept</data>
      <data key="d2">A reasoning approach that breaks down complex problems into structured, sequential steps, improving problem-solving with LLMs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Computational Overhead">
      <data key="d0">Computational Overhead</data>
      <data key="d1">concept</data>
      <data key="d2">The increased processing cost and time due to incorporating large retrieved texts or complex data structures, especially for LLMs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Recommender systems">
      <data key="d0">Recommender systems</data>
      <data key="d1">technology</data>
      <data key="d2">Systems that suggest relevant items to users, where integrating large retrieved texts with LLMs can significantly amplify computational overhead.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Graph-structured data">
      <data key="d0">Graph-structured data</data>
      <data key="d1">concept</data>
      <data key="d2">A fundamental input format representing entities and their relationships as nodes and edges, posing processing challenges for LLMs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Node classification">
      <data key="d0">Node classification</data>
      <data key="d1">concept</data>
      <data key="d2">A graph-related task involving assigning categories or labels to nodes within a graph-structured dataset.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Link prediction">
      <data key="d0">Link prediction</data>
      <data key="d1">concept</data>
      <data key="d2">A graph-related task involving predicting the existence of a relationship between two entities (nodes) in a graph.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Text-attributed networks">
      <data key="d0">Text-attributed networks</data>
      <data key="d1">concept</data>
      <data key="d2">Networks where nodes or edges have associated textual descriptions, often used with graph-structured data.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Minimum cut problem">
      <data key="d0">Minimum cut problem</data>
      <data key="d1">concept</data>
      <data key="d2">A complex problem in graph theory involving partitioning a graph to minimize connections between partitions.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Large-scale graph">
      <data key="d0">Large-scale graph</data>
      <data key="d1">concept</data>
      <data key="d2">Graphs with a massive number of nodes and edges, presenting scalability challenges for LLMs due to input length limitations.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Social network analysis">
      <data key="d0">Social network analysis</data>
      <data key="d1">concept</data>
      <data key="d2">The study of social structures using network and graph theory, benefiting from GraphRAG's ability to handle large graphs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Bioinformatics">
      <data key="d0">Bioinformatics</data>
      <data key="d1">concept</data>
      <data key="d2">An interdisciplinary field that develops methods for understanding biological data, where GraphRAG could handle complex biological networks.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge graph construction">
      <data key="d0">Knowledge graph construction</data>
      <data key="d1">method</data>
      <data key="d2">The process of building a knowledge graph by extracting entities and relationships from various data sources, enriching LLMs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge quality">
      <data key="d0">Knowledge quality</data>
      <data key="d1">concept</data>
      <data key="d2">The accuracy, consistency, completeness, and relevance of external knowledge, critical for GraphRAG model effectiveness.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge engineering">
      <data key="d0">Knowledge engineering</data>
      <data key="d1">concept</data>
      <data key="d2">A discipline focused on developing mechanisms for organizing, refining, and expanding knowledge to improve its quality in AI systems.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Neuro-symbolic approaches">
      <data key="d0">Neuro-symbolic approaches</data>
      <data key="d1">method</data>
      <data key="d2">Hybrid approaches combining neural networks with symbolic reasoning systems for more expressive and interpretable models.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Embedding techniques">
      <data key="d0">Embedding techniques</data>
      <data key="d1">method</data>
      <data key="d2">Methods to represent discrete entities as continuous vectors, capturing semantic relationships.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Automated quality assurance frameworks">
      <data key="d0">Automated quality assurance frameworks</data>
      <data key="d1">technology</data>
      <data key="d2">Systems designed to automatically identify inconsistencies, remove redundancies, and validate factual accuracy of knowledge bases.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Cross-validation">
      <data key="d0">Cross-validation</data>
      <data key="d1">method</data>
      <data key="d2">A statistical method to evaluate model performance by partitioning and testing on different subsets of data.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Statistical analysis">
      <data key="d0">Statistical analysis</data>
      <data key="d1">method</data>
      <data key="d2">The process of collecting, analyzing, and interpreting data, used in knowledge refinement for validating accuracy.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Machine learning">
      <data key="d0">Machine learning</data>
      <data key="d1">concept</data>
      <data key="d2">A field of AI enabling systems to learn from data without explicit programming, used in knowledge refinement and other tasks.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Automated web crawling">
      <data key="d0">Automated web crawling</data>
      <data key="d1">method</data>
      <data key="d2">A process of systematically browsing the web to collect information for continuous knowledge enrichment.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="API integrations">
      <data key="d0">API integrations</data>
      <data key="d1">technology</data>
      <data key="d2">Connecting different software applications via their APIs to enable data exchange for knowledge expansion.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Expert feedback loops">
      <data key="d0">Expert feedback loops</data>
      <data key="d1">method</data>
      <data key="d2">A process where human experts provide input and validation to ensure the quality and accuracy of knowledge within systems.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Multimodal information">
      <data key="d0">Multimodal information</data>
      <data key="d1">concept</data>
      <data key="d2">Information presented in multiple modalities (e.g., text, images, videos), integrated to provide comprehensive understanding.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge validation frameworks">
      <data key="d0">Knowledge validation frameworks</data>
      <data key="d1">technology</data>
      <data key="d2">Systems designed to ensure the reliability and integrity of knowledge, especially across different data modalities.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Anomaly detection">
      <data key="d0">Anomaly detection</data>
      <data key="d1">method</data>
      <data key="d2">The process of identifying data points that deviate significantly from the norm, used in knowledge validation.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge base completion">
      <data key="d0">Knowledge base completion</data>
      <data key="d1">method</data>
      <data key="d2">The task of inferring missing facts or relationships within a knowledge base.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Alignment (Knowledge Bases)">
      <data key="d0">Alignment (Knowledge Bases)</data>
      <data key="d1">method</data>
      <data key="d2">Ensuring consistency and coherence between different knowledge sources or external knowledge and model-generated outputs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge conflict">
      <data key="d0">Knowledge conflict</data>
      <data key="d1">concept</data>
      <data key="d2">A challenge in GraphRAG models where integrating multiple sources leads to contradictory or inconsistent information.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge reconciliation">
      <data key="d0">Knowledge reconciliation</data>
      <data key="d1">method</data>
      <data key="d2">Resolving discrepancies and harmonizing information from multiple, potentially conflicting, knowledge sources.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Conflict resolution">
      <data key="d0">Conflict resolution</data>
      <data key="d1">method</data>
      <data key="d2">Techniques used to identify and settle contradictory statements or data points in knowledge integration.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Truth discovery">
      <data key="d0">Truth discovery</data>
      <data key="d1">method</data>
      <data key="d2">Determining the most probable accurate information from conflicting data sources based on available evidence and source reliability.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Knowledge distillation">
      <data key="d0">Knowledge distillation</data>
      <data key="d1">method</data>
      <data key="d2">Training a smaller model to mimic a larger one, used for efficiency or harmonizing structured knowledge with LLMs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Cross-modal integration">
      <data key="d0">Cross-modal integration</data>
      <data key="d1">method</data>
      <data key="d2">Combining information from different data modalities (e.g., text, images) for comprehensive representation.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Uncertainty modeling">
      <data key="d0">Uncertainty modeling</data>
      <data key="d1">method</data>
      <data key="d2">Quantifying and representing the level of uncertainty in predictions or knowledge, enabling nuanced decisions.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Probabilistic reasoning frameworks">
      <data key="d0">Probabilistic reasoning frameworks</data>
      <data key="d1">technology</data>
      <data key="d2">Frameworks using probability theory to handle uncertain or incomplete information, assigning confidence scores.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Data privacy">
      <data key="d0">Data privacy</data>
      <data key="d1">concept</data>
      <data key="d2">The ethical and legal responsibility to protect sensitive information from unauthorized access, critical in GraphRAG systems.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Privacy-preserving knowledge integration">
      <data key="d0">Privacy-preserving knowledge integration</data>
      <data key="d1">method</data>
      <data key="d2">Techniques allowing combination of sensitive information from different sources while maintaining privacy guarantees.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Privacy-preserving retrieval">
      <data key="d0">Privacy-preserving retrieval</data>
      <data key="d1">method</data>
      <data key="d2">Techniques enabling retrieval of information from knowledge graphs without revealing sensitive query or data details.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Secure multi-party computation (MPC)">
      <data key="d0">Secure multi-party computation (MPC)</data>
      <data key="d1">method</data>
      <data key="d2">A cryptographic method allowing multiple parties to jointly compute a function over their private inputs.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Homomorphic encryption">
      <data key="d0">Homomorphic encryption</data>
      <data key="d1">method</data>
      <data key="d2">Encryption allowing computations on encrypted data without decryption, enabling privacy-preserving processing.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720472</data>
    </node>
    <node id="Differential privacy mechanisms">
      <data key="d0">Differential privacy mechanisms</data>
      <data key="d1">method</data>
      <data key="d2">Techniques that add controlled noise to data or query results to protect individual privacy while allowing aggregate analysis.</data>
      <data key="d3">chunk-73e6d6a5ae112be760116934a9ae4418</data>
