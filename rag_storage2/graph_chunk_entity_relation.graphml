  <graph edgedefault="undirected">
    <node id="GraphRAG">
      <data key="d0">GraphRAG</data>
      <data key="d1">concept</data>
      <data key="d2">A general approach to Retrieval-Augmented Generation that leverages knowledge graphs. Zep's community detection approach builds upon techniques described in GraphRAG, and it's mentioned as a promising area for future research.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="Retrieval-Augmented Generation (RAG)">
      <data key="d0">Retrieval-Augmented Generation (RAG)</data>
      <data key="d1">concept</data>
      <data key="d2">A framework for Large Language Model (LLM)-based applications that leverages Information Retrieval (IR) techniques to supply necessary domain knowledge to LLMs, typically for static document retrieval.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="Large Language Models (LLMs)">
      <data key="d0">Large Language Models (LLMs)</data>
      <data key="d1">technology</data>
      <data key="d2">Advanced AI models, often transformer-based, whose capabilities are limited by context windows and pre-training knowledge, leading to the development of external memory layers like Zep.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="Query-Focused Summarization (QFS)">
      <data key="d0">Query-Focused Summarization (QFS)</data>
      <data key="d1">concept</data>
      <data key="d2">A task that Microsoft's GraphRAG system aims to enhance by capturing local and global relationships within document collections to generate summaries relevant to a specific query.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Microsoft Research">
      <data key="d0">Microsoft Research</data>
      <data key="d1">organization</data>
      <data key="d2">A research division of Microsoft, serving as the primary affiliation for several authors of the GraphRAG paper.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Microsoft Strategic Missions and Technologies">
      <data key="d0">Microsoft Strategic Missions and Technologies</data>
      <data key="d1">organization</data>
      <data key="d2">A Microsoft division listed as an affiliation for authors contributing to the GraphRAG research.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Microsoft Office of the CTO">
      <data key="d0">Microsoft Office of the CTO</data>
      <data key="d1">organization</data>
      <data key="d2">A Microsoft division providing affiliation for authors involved in the GraphRAG project.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Knowledge Graph">
      <data key="d0">Knowledge Graph</data>
      <data key="d1">concept</data>
      <data key="d2">A structured representation of information, where nodes represent entities and edges represent relationships between them, used by GraphRAG as an index derived from source documents.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Vector RAG">
      <data key="d0">Vector RAG</data>
      <data key="d1">methodology</data>
      <data key="d2">A conventional Retrieval-Augmented Generation (RAG) approach that uses text embeddings to retrieve semantically similar records, effective for localized information but less so for global sensemaking.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Sensemaking Queries">
      <data key="d0">Sensemaking Queries</data>
      <data key="d1">concept</data>
      <data key="d2">Questions that demand a global understanding and reasoning over an entire dataset, rather than direct retrieval of isolated facts, which GraphRAG aims to address.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="LLM-as-a-judge">
      <data key="d0">LLM-as-a-judge</data>
      <data key="d1">method</data>
      <data key="d2">An evaluation technique where one LLM generates questions and another LLM judges the quality of answers from different systems, particularly useful for tasks lacking ground-truth answers.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="LangChain">
      <data key="d0">LangChain</data>
      <data key="d1">technology</data>
      <data key="d2">An open-source library supporting various graph databases for RAG applications.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="LlamaIndex">
      <data key="d0">LlamaIndex</data>
      <data key="d1">technology</data>
      <data key="d2">A framework used for implementing the KG-GraphRAG methods.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="NebulaGraph">
      <data key="d0">NebulaGraph</data>
      <data key="d1">technology</data>
      <data key="d2">An open-source graph database that integrates with GraphRAG for knowledge graph management.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Neo4J">
      <data key="d0">Neo4J</data>
      <data key="d1">technology</data>
      <data key="d2">A popular graph database that offers ecosystem tools and extensions for implementing GraphRAG.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="HotPotQA">
      <data key="d0">HotPotQA</data>
      <data key="d1">dataset</data>
      <data key="d2">A widely used multi-hop question answering dataset.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="MultiHop-RAG">
      <data key="d0">MultiHop-RAG</data>
      <data key="d1">dataset</data>
      <data key="d2">A QA dataset designed to evaluate retrieval and reasoning across multiple documents in RAG pipelines, categorized into Inference, Comparison, Temporal, and Null queries.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
      <data key="d5">1753720576</data>
    </node>
    <node id="MT-Bench">
      <data key="d0">MT-Bench</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset utilized for evaluating the performance of large language models acting as judges in conversational AI settings.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Adaptive Benchmarking">
      <data key="d0">Adaptive Benchmarking</data>
      <data key="d1">method</data>
      <data key="d2">A process for dynamically generating evaluation benchmarks tailored to specific domains or use cases, often using LLMs to ensure relevance and diversity.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Persona Generation">
      <data key="d0">Persona Generation</data>
      <data key="d1">method</data>
      <data key="d2">A technique employing LLMs to create realistic hypothetical user personas, which in turn inform the generation of corpus-specific sensemaking queries for system evaluation.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Podcast transcripts dataset">
      <data key="d0">Podcast transcripts dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A real-world dataset comprising public transcripts from 'Behind the Tech with Kevin Scott' podcast, used in Experiment 1 to evaluate GraphRAG performance.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="News articles dataset">
      <data key="d0">News articles dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A real-world benchmark dataset of news articles across various categories, used in Experiment 1 to evaluate GraphRAG performance.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Comprehensiveness (Criterion)">
      <data key="d0">Comprehensiveness (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric assessing the extent to which an answer covers all relevant aspects and details of a question thoroughly and completely.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Diversity (Criterion)">
      <data key="d0">Diversity (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric that measures the variety and richness of perspectives and insights provided in an answer to a question.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Empowerment (Criterion)">
      <data key="d0">Empowerment (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric assessing how well an answer helps a reader understand a topic and make informed judgments, emphasizing clarity, reasoning, and supporting sources.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Directness (Criterion)">
      <data key="d0">Directness (Criterion)</data>
      <data key="d1">concept</data>
      <data key="d2">A control evaluation metric that assesses how specifically and clearly an answer addresses a question, focusing on conciseness and lack of irrelevant information.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Factual Claim">
      <data key="d0">Factual Claim</data>
      <data key="d1">concept</data>
      <data key="d2">A statement that explicitly presents verifiable facts, used as a fundamental unit for claim-based evaluation metrics like comprehensiveness and diversity.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Claimify">
      <data key="d0">Claimify</data>
      <data key="d1">tool</data>
      <data key="d2">An LLM-based method designed to identify and decompose sentences from answers into simple, self-contained factual claims for quantitative analysis.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Agglomerative Clustering">
      <data key="d0">Agglomerative Clustering</data>
      <data key="d1">method</data>
      <data key="d2">A hierarchical clustering algorithm utilized to group similar factual claims for the purpose of measuring answer diversity.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="ROUGE-L">
      <data key="d0">ROUGE-L</data>
      <data key="d1">metric</data>
      <data key="d2">A recall-oriented metric commonly used to assess the quality of text generated by models, based on the longest common subsequence.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="Self-reflection (Prompt Engineering)">
      <data key="d0">Self-reflection (Prompt Engineering)</data>
      <data key="d1">technique</data>
      <data key="d2">A prompt engineering technique where an LLM evaluates and refines its own generated output, used in knowledge graph extraction to improve entity detection quality.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Leiden Community Detection">
      <data key="d0">Leiden Community Detection</data>
      <data key="d1">algorithm</data>
      <data key="d2">A graph partitioning algorithm applied in GraphRAG to hierarchically divide the knowledge graph into communities of strongly connected nodes.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="GPT-4">
      <data key="d0">GPT-4</data>
      <data key="d1">technology</data>
      <data key="d2">A specific large language model, mentioned as an example of LLMs.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Graspy library">
      <data key="d0">Graspy library</data>
      <data key="d1">technology</data>
      <data key="d2">A Python library focused on graph statistics, specifically used for implementing Leiden community detection in the GraphRAG project.</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="Map-Reduce Summarization">
      <data key="d0">Map-Reduce Summarization</data>
      <data key="d1">method</data>
      <data key="d2">A multi-stage summarization process used in GraphRAG where partial answers from communities are generated in parallel (map) and then combined into a final global answer (reduce).</data>
      <data key="d3">chunk-5973cf06c94ca0a544fcef3b543e14b0</data>
      <data key="d4">pdfs/graphrag/microsoft graphrag.pdf</data>
      <data key="d5">1753720082</data>
    </node>
    <node id="LIGHTRAG">
      <data key="d0">LIGHTRAG</data>
      <data key="d1">technology</data>
      <data key="d2">A proposed Retrieval-Augmented Generation (RAG) framework that incorporates graph structures into text indexing and retrieval processes, employing a dual-level retrieval system to enhance comprehensive information retrieval and improve response times. It also features an incremental update algorithm.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Retrieval-Augmented Generation (RAG) systems">
      <data key="d0">Retrieval-Augmented Generation (RAG) systems</data>
      <data key="d1">concept</data>
      <data key="d2">Systems designed to enhance large language models (LLMs) by integrating external knowledge sources, enabling more accurate and contextually relevant responses tailored to user needs.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="large language models (LLMs)">
      <data key="d0">large language models (LLMs)</data>
      <data key="d1">technology</data>
      <data key="d2">AI models capable of generating human-like text, often empowered by RAG to access external knowledge.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="Graph structures">
      <data key="d0">Graph structures</data>
      <data key="d1">concept</data>
      <data key="d2">A data representation method used in LightRAG to effectively represent the interdependencies among different entities, fostering a nuanced understanding of relationships and enabling coherent, contextually rich responses.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Dual-level retrieval system">
      <data key="d0">Dual-level retrieval system</data>
      <data key="d1">method</data>
      <data key="d2">An innovative retrieval approach employed by LightRAG that accommodates diverse query types by performing both low-level retrieval (focused on specific entities) and high-level retrieval (encompassing broader topics).</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Incremental update algorithm">
      <data key="d0">Incremental update algorithm</data>
      <data key="d1">method</data>
      <data key="d2">An algorithm in LightRAG that ensures the timely and efficient integration of new data into the knowledge base without the need for full reconstruction, allowing the system to remain effective and responsive.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Zirui Guo">
      <data key="d0">Zirui Guo</data>
      <data key="d1">person</data>
      <data key="d2">An author of the paper, affiliated with Beijing University of Posts and Telecommunications and University of Hong Kong.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="Lianghao Xia">
      <data key="d0">Lianghao Xia</data>
      <data key="d1">person</data>
      <data key="d2">One of the authors of the LIGHTRAG paper, affiliated with University of Hong Kong.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Yanhua Yu">
      <data key="d0">Yanhua Yu</data>
      <data key="d1">person</data>
      <data key="d2">One of the corresponding authors of the LIGHTRAG paper, affiliated with Beijing University of Posts and Telecommunications.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Tu Ao">
      <data key="d0">Tu Ao</data>
      <data key="d1">person</data>
      <data key="d2">One of the authors of the LIGHTRAG paper, affiliated with Beijing University of Posts and Telecommunications.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Chao Huang">
      <data key="d0">Chao Huang</data>
      <data key="d1">person</data>
      <data key="d2">One of the corresponding authors of the LIGHTRAG paper, affiliated with University of Hong Kong.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Beijing University of Posts and Telecommunications">
      <data key="d0">Beijing University of Posts and Telecommunications</data>
      <data key="d1">organization</data>
      <data key="d2">A university where several authors of the PathRAG paper are affiliated, and which hosts the BUPT-GAMMA research group.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="University of Hong Kong">
      <data key="d0">University of Hong Kong</data>
      <data key="d1">organization</data>
      <data key="d2">A university where one of the authors (Zirui Guo) is affiliated.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="flat data representations">
      <data key="d0">flat data representations</data>
      <data key="d1">concept</data>
      <data key="d2">A limitation identified in existing RAG systems where information is stored without explicit connections between entities, restricting the ability to understand intricate relationships.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="contextual awareness">
      <data key="d0">contextual awareness</data>
      <data key="d1">concept</data>
      <data key="d2">The ability of a system to maintain coherence across various entities and their interrelations, often lacking in existing RAG systems, leading to fragmented answers.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Chunking">
      <data key="d0">Chunking</data>
      <data key="d1">method</data>
      <data key="d2">A vital process in retrieval-augmented generation that involves breaking down a large external text corpus into smaller, more manageable segments to enhance the accuracy of information retrieval.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="knowledge graph">
      <data key="d0">knowledge graph</data>
      <data key="d1">concept</data>
      <data key="d2">A comprehensive graph structure created from extracted entities and relationships, used in LightRAG to highlight connections and insights across a collection of documents.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Entity and Relationship Extraction">
      <data key="d0">Entity and Relationship Extraction</data>
      <data key="d1">method</data>
      <data key="d2">A process in LightRAG that leverages LLMs to identify entities (nodes) and their relationships (edges) within text data, forming the basis of the knowledge graph.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="LLM Profiling">
      <data key="d0">LLM Profiling</data>
      <data key="d1">method</data>
      <data key="d2">A function in LightRAG that employs an LLM to generate text key-value pairs for each entity node and relation edge, enabling efficient retrieval and text generation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Deduplication">
      <data key="d0">Deduplication</data>
      <data key="d1">method</data>
      <data key="d2">A function in LightRAG that identifies and merges identical entities and relations from different text segments, reducing overhead and optimizing graph operations.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="vector representations">
      <data key="d0">vector representations</data>
      <data key="d1">concept</data>
      <data key="d2">Numerical embeddings of text or entities, integrated with graph structures in LightRAG to facilitate efficient retrieval of related entities and their relationships.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Retrieval Component">
      <data key="d0">Retrieval Component</data>
      <data key="d1">concept</data>
      <data key="d2">An essential element of the RAG framework responsible for fetching relevant documents or information from an external knowledge database based on the input query.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Generation Component">
      <data key="d0">Generation Component</data>
      <data key="d1">concept</data>
      <data key="d2">An essential element of the RAG framework that takes the retrieved information and generates coherent, contextually relevant responses by leveraging the capabilities of a language model.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Data Indexer">
      <data key="d0">Data Indexer</data>
      <data key="d1">method</data>
      <data key="d2">A functionality within the RAG retrieval module responsible for building a specific data structure based on the external database for efficient querying.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Data Retriever">
      <data key="d0">Data Retriever</data>
      <data key="d1">method</data>
      <data key="d2">A functionality within the RAG retrieval module that obtains relevant documents by comparing the query against the indexed data.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Query Keyword Extraction">
      <data key="d0">Query Keyword Extraction</data>
      <data key="d1">method</data>
      <data key="d2">The initial step in LightRAG's retrieval algorithm for a given query, involving the extraction of both local (specific details) and global (broad concepts) query keywords.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="Keyword Matching">
      <data key="d0">Keyword Matching</data>
      <data key="d1">method</data>
      <data key="d2">A process in LightRAG that utilizes an efficient vector database to match local query keywords with candidate entities and global query keywords with relations linked to global keys.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="High-Order Relatedness">
      <data key="d0">High-Order Relatedness</data>
      <data key="d1">concept</data>
      <data key="d2">The enhancement of a query in LightRAG by gathering neighboring nodes within the local subgraphs of retrieved graph elements, providing a more comprehensive understanding.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="UltraDomain benchmark">
      <data key="d0">UltraDomain benchmark</data>
      <data key="d1">dataset</data>
      <data key="d2">A benchmark dataset sourced from college textbooks across 18 distinct domains, used for evaluating RAG models, including datasets like Agriculture, Legal, History, CS, Biology, and Mix.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="Agriculture dataset">
      <data key="d0">Agriculture dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A dataset from the UltraDomain benchmark focusing on the agricultural domain, covering practices such as beekeeping, crop cultivation, and farm management.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="CS dataset">
      <data key="d0">CS dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A dataset from the UltraDomain benchmark focusing on computer science, covering multiple subfields such as algorithms, artificial intelligence, machine learning, and computer networks.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="Legal dataset">
      <data key="d0">Legal dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A dataset from the UltraDomain benchmark focusing on the legal domain, covering aspects such as case law, legal regulations, and judicial procedures.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="Mix dataset">
      <data key="d0">Mix dataset</data>
      <data key="d1">dataset</data>
      <data key="d2">A dataset from the UltraDomain benchmark containing a variety of literary classics, including essays, poetry, and biographies, covering multiple fields such as philosophy, history, and literature.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="Naive RAG">
      <data key="d0">Naive RAG</data>
      <data key="d1">technology</data>
      <data key="d2">A standard baseline RAG system that segments raw texts into chunks and stores them in a vector database, retrieving chunks based on the highest similarity to vectorized queries.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="RQ-RAG">
      <data key="d0">RQ-RAG</data>
      <data key="d1">technology</data>
      <data key="d2">An RAG approach that leverages LLMs to decompose input queries into multiple sub-queries to enhance search accuracy through techniques such as rewriting, decomposition, and disambiguation.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="HyDE">
      <data key="d0">HyDE</data>
      <data key="d1">method</data>
      <data key="d2">An improved RAG method that generates 'hypothetical' texts to retrieve relevant documents.</data>
      <data key="d3">chunk-6aab8177dccf033fdee79260a9b335ec</data>
      <data key="d4">pdfs/graphrag/noderag.pdf</data>
      <data key="d5">1753720206</data>
    </node>
    <node id="nano vector database">
      <data key="d0">nano vector database</data>
      <data key="d1">technology</data>
      <data key="d2">A specific vector database utilized in the LightRAG experiments for efficient vector data management and access.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="GPT-4o-mini">
      <data key="d0">GPT-4o-mini</data>
      <data key="d1">technology</data>
      <data key="d2">A Large Language Model used uniformly for all LLM-related components across baseline methods and PathRAG, including answer generation and evaluation.</data>
      <data key="d3">chunk-b25520a9bfa83b9cad32ccb8f89d5538</data>
      <data key="d4">pdfs/graphrag/pathrag.pdf</data>
      <data key="d5">1753720133</data>
    </node>
    <node id="Graph Neural Networks (GNNs)">
      <data key="d0">Graph Neural Networks (GNNs)</data>
      <data key="d1">technology</data>
      <data key="d2">A class of neural networks designed to process graph-structured data, leveraged by some GraphRAG methods (e.g., GNN-RAG) for effective retrieval.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="GraphGPT">
      <data key="d0">GraphGPT</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG system that fine-tunes LLMs with node-level knowledge, learning node embeddings for integration.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
