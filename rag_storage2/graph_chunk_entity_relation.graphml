      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
      <data key="d5">1753720367</data>
    </node>
    <node id="KELP">
      <data key="d0">KELP</data>
      <data key="d1">technology</data>
      <data key="d2">A GraphRAG method that adopts a semantic-matching strategy, encoding questions and candidate knowledge paths to select paths with the smallest semantic distance.</data>
      <data key="d3">chunk-f14a9ca99a33848e15f3d4e962728fa6</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper 2.pdf</data>
