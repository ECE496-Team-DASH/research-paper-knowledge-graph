    <node id="semantic similarity-based retrieval">
      <data key="d0">semantic similarity-based retrieval</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval approach used in RAG where relevant text chunks are retrieved by computing semantic similarity, often using embeddings.</data>
      <data key="d3">chunk-a83834acbef8d77bea1f43033aef4cf4</data>
      <data key="d4">pdfs/graphrag/rag vs graphrag.pdf</data>
