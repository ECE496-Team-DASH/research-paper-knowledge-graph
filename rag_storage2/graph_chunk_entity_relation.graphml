      <data key="d1">technology</data>
      <data key="d2">An AI engineering framework used as a foundation for Antgroup's industrial GraphRAG system.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="OpenSPG">
      <data key="d0">OpenSPG</data>
      <data key="d1">technology</data>
      <data key="d2">A knowledge graph engine integrated into Antgroup's industrial GraphRAG framework.</data>
      <data key="d3">chunk-ca5901e64f1cef51e157bab1c3db22ad</data>
      <data key="d4">pdfs/graphrag/graphrag survey paper.pdf</data>
      <data key="d5">1753720284</data>
    </node>
    <node id="TuGraph">
