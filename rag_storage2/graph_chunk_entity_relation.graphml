    <node id="LLaGA">
      <data key="d0">LLaGA</data>
      <data key="d1">technology</data>
      <data key="d2">An example system where Graph Neural Networks (GNNs) are utilized as an initial processing layer for graph data, generating structure-aware tokens for LLMs.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="GALM">
      <data key="d0">GALM</data>
      <data key="d1">technology</data>
      <data key="d2">An example system where LLMs process graph data enriched with textual information to produce node embeddings or labels, refining the training process for GNNs.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
    <node id="OFA">
      <data key="d0">OFA</data>
      <data key="d1">technology</data>
      <data key="d2">An example system where LLMs process graph data enriched with textual information to produce node embeddings or labels, refining the training process for GNNs.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
      <data key="d5">1753720107</data>
    </node>
