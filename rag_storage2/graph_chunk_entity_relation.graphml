    <node id="Zep">
      <data key="d0">Zep</data>
      <data key="d1">technology</data>
      <data key="d2">A novel memory layer service for AI agents, designed to dynamically integrate knowledge from diverse sources and maintain historical relationships using a temporally-aware knowledge graph engine called Graphiti. It outperforms MemGPT in the Deep Memory Retrieval (DMR) benchmark and shows substantial improvements in accuracy and latency on the LongMemEval benchmark.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="Graphiti">
      <data key="d0">Graphiti</data>
      <data key="d1">technology</data>
      <data key="d2">The core component of Zep, a dynamic and temporally-aware knowledge graph engine that synthesizes unstructured conversational data and structured business data while maintaining historical relationships and periods of validity. It manages dynamic information updates through temporal extraction and edge invalidation.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="Preston Rasmussen">
      <data key="d0">Preston Rasmussen</data>
      <data key="d1">person</data>
      <data key="d2">An author of the paper, affiliated with Zep AI.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
    <node id="Pavlo Paliychuk">
      <data key="d0">Pavlo Paliychuk</data>
      <data key="d1">person</data>
      <data key="d2">An author of the paper, affiliated with Zep AI.</data>
      <data key="d3">chunk-abd9a1af6fbc0228958274294f75bef7</data>
      <data key="d4">pdfs/graphrag/zep graphiti.pdf</data>
      <data key="d5">1753720603</data>
    </node>
