      <data key="d2">A corresponding author of the LightRAG research paper, affiliated with the University of Hong Kong.</data>
      <data key="d3">chunk-65cf69523fd4a62056b15c4a1226d1c6</data>
      <data key="d4">pdfs/graphrag/lightrag.pdf</data>
