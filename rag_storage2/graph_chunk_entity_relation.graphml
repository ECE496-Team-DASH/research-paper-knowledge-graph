      <data key="d0">GraphRAG-Filtering</data>
      <data key="d1">method</data>
      <data key="d2">A core component of GraphRAG-FI that employs a two-stage filtering mechanism to refine retrieved information, enhancing its quality and relevance.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="GraphRAG-Integration">
      <data key="d0">GraphRAG-Integration</data>
      <data key="d1">method</data>
      <data key="d2">A core component of GraphRAG-FI that employs a logits-based selection strategy to balance external knowledge from GraphRAG with the LLM’s intrinsic reasoning, reducing over-reliance on retrievals.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="Two-stage filtering mechanism">
      <data key="d0">Two-stage filtering mechanism</data>
      <data key="d1">method</data>
      <data key="d2">A technique used in GraphRAG-Filtering, involving coarse filtering based on attention scores and fine filtering using LLMs, to effectively refine retrieved knowledge.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="Logits-based selection strategy">
      <data key="d0">Logits-based selection strategy</data>
      <data key="d1">method</data>
      <data key="d2">A mechanism used in GraphRAG-Integration that leverages the confidence scores (logits) of LLM predictions to dynamically integrate LLM standalone answers with GraphRAG's outputs, balancing internal and external knowledge.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="LLaMA 2-7B">
      <data key="d0">LLaMA 2-7B</data>
      <data key="d1">technology</data>
      <data key="d2">A specific open-source large language model used as the LLM backbone in the experimental evaluation of GraphRAG and GraphRAG-FI.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="RoG (Reasoning on Graphs)">
      <data key="d0">RoG (Reasoning on Graphs)</data>
      <data key="d1">method</data>
      <data key="d2">A specific GraphRAG framework that introduces a planning-retrieval-reasoning framework, used as a retriever backbone for evaluating GraphRAG-FI.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
    <node id="GNN-RAG">
      <data key="d0">GNN-RAG</data>
      <data key="d1">method</data>
      <data key="d2">A method that adopts a lightweight graph neural network to effectively retrieve elements from Knowledge Graphs for RAG.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="PageRank-based filtering">
      <data key="d0">PageRank-based filtering</data>
      <data key="d1">method</data>
      <data key="d2">A baseline filtering method that leverages the graph structure to rank nodes based on their connectivity and importance, used for comparison with GraphRAG-FI.</data>
      <data key="d3">chunk-c0a66952372ea2d9c4c7043097a13cc6</data>
      <data key="d4">pdfs/graphrag/graphrag knowledge filtering.pdf</data>
      <data key="d5">1753720497</data>
    </node>
