    </node>
    <node id="Llama 3.1">
      <data key="d0">Llama 3.1</data>
      <data key="d1">technology</data>
      <data key="d2">A specific large language model, mentioned as an example of LLMs and used as a default LLM in experiments.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="BGE-M3">
      <data key="d0">BGE-M3</data>
      <data key="d1">technology</data>
      <data key="d2">A text-encoder model used for generating embeddings, employed as the embedding model across all experimental methods.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="ColBert">
      <data key="d0">ColBert</data>
      <data key="d1">technology</data>
      <data key="d2">A text-encoder model used for generating embeddings.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Vector database">
      <data key="d0">Vector database</data>
      <data key="d1">technology</data>
      <data key="d2">A database optimized for storing and querying high-dimensional vectors, used for efficient online retrieval.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Ascend 910B-3 NPUs">
      <data key="d0">Ascend 910B-3 NPUs</data>
      <data key="d1">technology</data>
      <data key="d2">Neural Processing Units used for running the experiments.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Python">
      <data key="d0">Python</data>
      <data key="d1">technology</data>
      <data key="d2">The programming language used to implement the algorithms within the unified framework.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Nebula">
      <data key="d0">Nebula</data>
      <data key="d1">technology</data>
      <data key="d2">A well-known graph database system mentioned as supporting knowledge graph creation via LLM.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Artificial intelligence">
      <data key="d0">Artificial intelligence</data>
      <data key="d1">concept</data>
      <data key="d2">The field that LLMs have revolutionized, focusing on creating intelligent machines.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Hallucination (LLMs)">
      <data key="d0">Hallucination (LLMs)</data>
      <data key="d1">concept</data>
      <data key="d2">A problem where LLMs generate incorrect, nonsensical, or unfaithful responses due to lack of external knowledge.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Question-answering (QA) datasets">
      <data key="d0">Question-answering (QA) datasets</data>
      <data key="d1">concept</data>
      <data key="d2">Datasets used for evaluating the performance of RAG methods in answering questions.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Specific questions">
      <data key="d0">Specific questions</data>
      <data key="d1">concept</data>
      <data key="d2">A category of QA tasks that are detail-oriented and typically reference specific entities within the graph.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Abstract questions">
      <data key="d0">Abstract questions</data>
      <data key="d1">concept</data>
      <data key="d2">A category of QA tasks involving conceptual inquiries, summaries, or overarching themes, requiring high-level understanding.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Factual accuracy">
      <data key="d0">Factual accuracy</data>
      <data key="d1">concept</data>
      <data key="d2">A benefit of RAG, indicating improvement in the correctness of LLM-generated facts.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Adaptability">
      <data key="d0">Adaptability</data>
      <data key="d1">concept</data>
      <data key="d2">A benefit of RAG, indicating the ability of LLMs to adjust to new situations.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Interpretability">
      <data key="d0">Interpretability</data>
      <data key="d1">concept</data>
      <data key="d2">A benefit of RAG, indicating the ability to understand how LLMs arrive at their answers.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Trustworthiness">
      <data key="d0">Trustworthiness</data>
      <data key="d1">concept</data>
      <data key="d2">A benefit of RAG, indicating the reliability and credibility of LLM outputs.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Graph data">
      <data key="d0">Graph data</data>
      <data key="d1">concept</data>
      <data key="d2">A type of external data used in graph-based RAG to capture semantic information and link relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Prompt token">
      <data key="d0">Prompt token</data>
      <data key="d1">concept</data>
      <data key="d2">The part of LLM token cost accounting for the input tokens provided in a prompt.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Completion token">
      <data key="d0">Completion token</data>
      <data key="d1">concept</data>
      <data key="d2">The part of LLM token cost accounting for the tokens generated by the model as a response.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Accuracy (metric)">
      <data key="d0">Accuracy (metric)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric for specific QA tasks, based on whether gold answers are included in the generated outputs.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Recall (metric)">
      <data key="d0">Recall (metric)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric for specific QA tasks, reflecting the accuracy of generated responses, often preferred over precision.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="String Recall (STRREC)">
      <data key="d0">String Recall (STRREC)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric for ALCE dataset, measuring string recall when answers are full sentences.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="String Exact Match (STREM)">
      <data key="d0">String Exact Match (STREM)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric for ALCE dataset, measuring exact string matches when answers are full sentences.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="String Hit (STRHIT)">
      <data key="d0">String Hit (STRHIT)</data>
      <data key="d1">concept</data>
      <data key="d2">An evaluation metric for ALCE dataset, measuring if any part of the gold answer is present in the generated output.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Empowerment">
      <data key="d0">Empowerment</data>
      <data key="d1">Concept</data>
      <data key="d2">An evaluation criterion used in LLM-based multi-dimensional comparison, assessing how well an answer helps the reader understand and make informed judgments about the topic.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="Overall (evaluation)">
      <data key="d0">Overall (evaluation)</data>
      <data key="d1">concept</data>
      <data key="d2">A general quality assessment dimension for abstract QA tasks.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Chunk quality">
      <data key="d0">Chunk quality</data>
      <data key="d1">concept</data>
      <data key="d2">The quality of text segments derived from the corpus, which is crucial for the overall performance of all RAG methods.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Graph quality">
      <data key="d0">Graph quality</data>
      <data key="d1">concept</data>
      <data key="d2">The quality of the constructed graph, identified as a critical challenge affecting the effectiveness of graph-based RAG methods.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Local differential privacy">
      <data key="d0">Local differential privacy</data>
      <data key="d1">concept</data>
      <data key="d2">A privacy-preserving technique, proposed as a research opportunity for graph-based RAG methods dealing with private corpora.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Heterogeneous knowledge sources">
      <data key="d0">Heterogeneous knowledge sources</data>
      <data key="d1">concept</data>
      <data key="d2">Diverse types of external knowledge beyond text, such as PDFs, HTML, and structured data, proposed as a future research direction for RAG.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Graph-based Retrieval-Augmented Generation (Graph-based RAG)">
      <data key="d0">Graph-based Retrieval-Augmented Generation (Graph-based RAG)</data>
      <data key="d1">method</data>
      <data key="d2">A specialized RAG approach that employs graph structures constructed from external corpora to improve contextual understanding and response generation.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Unified framework">
      <data key="d0">Unified framework</data>
      <data key="d1">method</data>
      <data key="d2">A novel framework proposed in the paper consisting of four stages to systematically incorporate and compare all graph-based RAG methods.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="LLM Prompting">
      <data key="d0">LLM Prompting</data>
      <data key="d1">method</data>
      <data key="d2">The fundamental concept of guiding an LLM to complete tasks by constructing a comprehensive task description.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Vanilla RAG">
      <data key="d0">Vanilla RAG</data>
      <data key="d1">method</data>
      <data key="d2">A baseline RAG technique that retrieves knowledge directly from external chunks without employing a graph structure.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Graph building">
      <data key="d0">Graph building</data>
      <data key="d1">method</data>
      <data key="d2">The first stage of the unified framework, focusing on transforming the input corpus into a graph.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Index construction">
      <data key="d0">Index construction</data>
      <data key="d1">method</data>
      <data key="d2">The second stage of the unified framework, involving storing entities or relationships for efficient online retrieval.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Operator configuration">
      <data key="d0">Operator configuration</data>
      <data key="d1">method</data>
      <data key="d2">The third stage of the unified framework, where retriever operators are selected and combined.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Retrieval &amp; generation">
      <data key="d0">Retrieval &amp; generation</data>
      <data key="d1">method</data>
      <data key="d2">The fourth stage of the unified framework, where relevant information is retrieved and fed into the LLM to generate answers.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Passage Graph (PG)">
      <data key="d0">Passage Graph (PG)</data>
      <data key="d1">method</data>
      <data key="d2">A type of graph where each chunk represents a node, and edges are built using entity linking tools based on shared entities.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Tree (Graph Type)">
      <data key="d0">Tree (Graph Type)</data>
      <data key="d1">method</data>
      <data key="d2">A type of graph constructed progressively, where leaf nodes are chunks and higher-level nodes are generated as summaries by an LLM.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Textual Knowledge Graph (TKG)">
      <data key="d0">Textual Knowledge Graph (TKG)</data>
      <data key="d1">method</data>
      <data key="d2">A specialized Knowledge Graph where each entity and relationship is assigned a brief textual description.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Rich Knowledge Graph (RKG)">
      <data key="d0">Rich Knowledge Graph (RKG)</data>
      <data key="d1">method</data>
      <data key="d2">An extended version of TKG, including textual descriptions for entities and relationships, and keywords for relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Entity linking tools">
      <data key="d0">Entity linking tools</data>
      <data key="d1">method</data>
      <data key="d2">Tools used to create edges in Passage Graphs by identifying shared entities between chunks.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Node Index">
      <data key="d0">Node Index</data>
      <data key="d1">method</data>
      <data key="d2">A type of index storing graph nodes, typically in a vector database for retrieval.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Relationship Index">
      <data key="d0">Relationship Index</data>
      <data key="d1">method</data>
      <data key="d2">A type of index storing graph relationships, typically in a vector database for retrieval.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Community Index">
      <data key="d0">Community Index</data>
      <data key="d1">method</data>
      <data key="d2">A type of index storing community reports for graph communities, generated by clustering algorithms and LLMs.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="TF-IDF matrix">
      <data key="d0">TF-IDF matrix</data>
      <data key="d1">method</data>
      <data key="d2">An index type used in KGP to represent term-weight distribution across different nodes (chunks).</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Retrieval operators">
      <data key="d0">Retrieval operators</data>
      <data key="d1">method</data>
      <data key="d2">Modular components that define how information is retrieved from the graph in graph-based RAG methods.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="VDB (operator)">
      <data key="d0">VDB (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator leveraging a vector database to retrieve nodes or relationships by computing vector similarity with a query.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="RelNode (operator)">
      <data key="d0">RelNode (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that extracts nodes from provided relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Personalized PageRank (PPR) (operator)">
      <data key="d0">Personalized PageRank (PPR) (operator)</data>
      <data key="d1">method</data>
      <data key="d2">An algorithm-based retrieval operator used to identify top-k similar nodes or inform relationship scoring.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Agent (operator)">
      <data key="d0">Agent (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that utilizes LLMs to select nodes or relationships from a list of candidates.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Onehop (operator)">
      <data key="d0">Onehop (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that selects the one-hop neighbor entities or relationships of given entities.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Link (operator)">
      <data key="d0">Link (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that selects the top-1 most similar entity for each entity in a given set from a vector database.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="TF-IDF (operator)">
      <data key="d0">TF-IDF (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that retrieves top-k relevant entities by ranking them based on term frequency and inverse document frequency.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Aggregator (operator)">
      <data key="d0">Aggregator (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that selects relationships or chunks by summing scores of connected or contained entities/relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="FromRel (operator)">
      <data key="d0">FromRel (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that retrieves chunks that contain specified relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Occurrence (operator)">
      <data key="d0">Occurrence (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that selects chunks based on how many times they contain both entities in a relationship.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="KhopPath (operator)">
      <data key="d0">KhopPath (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that identifies k-hop paths in the graph.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Steiner (operator)">
      <data key="d0">Steiner (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that constructs a Steiner tree from identified relevant entities and relationships.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="AgentPath (operator)">
      <data key="d0">AgentPath (operator)</data>
      <data key="d1">method</data>
      <data key="d2">A retrieval operator that uses LLM to filter out irrelevant k-hop paths.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Entity (Community operator)">
      <data key="d0">Entity (Community operator)</data>
      <data key="d1">method</data>
      <data key="d2">A community operator that obtains and ranks communities containing specified entities based on LLM-generated ratings.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Layer (Community operator)">
      <data key="d0">Layer (Community operator)</data>
      <data key="d1">method</data>
      <data key="d2">A community operator that retrieves all communities below required layers in hierarchical communities.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Question conversion">
      <data key="d0">Question conversion</data>
      <data key="d1">method</data>
      <data key="d2">A stage in retrieval &amp; generation that transforms the user question into a retrieval primitive.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Directly (answer generation paradigm)">
      <data key="d0">Directly (answer generation paradigm)</data>
      <data key="d1">method</data>
      <data key="d2">An answer generation paradigm where the LLM directly generates the answer based on the prompt.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Map-Reduce (answer generation paradigm)">
      <data key="d0">Map-Reduce (answer generation paradigm)</data>
      <data key="d1">method</data>
      <data key="d2">An answer generation paradigm where retrieved information (e.g., communities) is analyzed independently in parallel, and partial answers are summarized into a final answer.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="Zeroshot">
      <data key="d0">Zeroshot</data>
      <data key="d1">Method</data>
      <data key="d2">A baseline or specific strategy evaluated for its token costs, likely referring to a zero-shot learning approach in RAG.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="HippoRAG">
      <data key="d0">HippoRAG</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="G-retriever">
      <data key="d0">G-retriever</data>
      <data key="d1">Method</data>
      <data key="d2">A graph-based retrieval method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="DALK">
      <data key="d0">DALK</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="LGraphRAG">
      <data key="d0">LGraphRAG</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="GGraphRAG">
      <data key="d0">GGraphRAG</data>
      <data key="d1">method</data>
      <data key="d2">A specific graph-based RAG method that utilizes Textual Knowledge Graphs and high-layer communities with a Map-Reduce strategy, generally performing best on abstract QA.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="FastGraphRAG">
      <data key="d0">FastGraphRAG</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="LLightRAG">
      <data key="d0">LLightRAG</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="GLightRAG">
      <data key="d0">GLightRAG</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="HLightRAG">
      <data key="d0">HLightRAG</data>
      <data key="d1">Method</data>
      <data key="d2">A specific graph-based RAG method evaluated for its token costs in the generation stage across various datasets.</data>
      <data key="d3">chunk-9b56db976c18e50fdd3c10cb91d5939f</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720550</data>
    </node>
    <node id="RAPTOR-K">
      <data key="d0">RAPTOR-K</data>
      <data key="d1">method</data>
      <data key="d2">A variant of RAPTOR that uses K-means clustering instead of Gaussian Mixture, demonstrating comparable performance.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="VGraphRAG-CC">
      <data key="d0">VGraphRAG-CC</data>
      <data key="d1">method</data>
      <data key="d2">A variant of LGraphRAG that introduces a vector search-based retrieval strategy for communities and chunks.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="VGraphRAG">
      <data key="d0">VGraphRAG</data>
      <data key="d1">method</data>
      <data key="d2">A new state-of-the-art graph-based RAG method proposed in the paper, combining entity/relationship retrieval with vector search for communities and chunks.</data>
      <data key="d3">chunk-15e4af5c218bdc431f5c19efb1692277</data>
      <data key="d4">pdfs/graphrag/graphrag in unified framework.pdf</data>
      <data key="d5">1753720544</data>
    </node>
    <node id="CheapRAG">
      <data key="d0">CheapRAG</data>
      <data key="d1">method</data>
